<div
    data-controller="session-lock"
    data-session-lock-timeout-seconds-value="{{ app_inactivity_timeout }}"
    data-session-lock-unlock-url-value="{{ path('app_session_unlock') }}"
    data-session-lock-lock-url-value="{{ path('app_session_lock') }}"
    data-session-lock-check-interval-value="60"
>
    <!-- Session Lock Modal -->
    <div
        data-session-lock-target="modal"
        class="modal fade"
        id="sessionLockModal"
        tabindex="-1"
        aria-hidden="true"
    >
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0 bg-danger bg-opacity-10">
                    <h5 class="modal-title text-danger">
                        <i class="fas fa-lock"></i> Session verrouillée
                    </h5>
                </div>
                <div class="modal-body text-center py-5">
                    <div class="mb-4">
                        <i class="fas fa-hourglass-end text-warning" style="font-size: 3rem;"></i>
                    </div>
                    <p class="text-muted mb-3">
                        Votre session s'est verrouillée suite à une inactivité prolongée.
                    </p>
                    <p class="mb-4">
                        <strong>Temps avant expiration:</strong>
                    </p>
                    <div class="timer-display mb-4">
                        <p style="font-size: 2.5rem; font-weight: bold; font-family: 'Courier New', monospace;">
                            <span data-session-lock-target="timerDisplay">30:00</span>
                        </p>
                    </div>

                    <form
                        data-session-lock-target="form"
                        data-action="session-lock#handleUnlock"
                        class="mt-4"
                        novalidate
                    >
                        <div class="mb-3">
                            <label for="sessionPassword" class="form-label">Mot de passe</label>
                            <input
                                type="password"
                                class="form-control form-control-lg"
                                id="sessionPassword"
                                placeholder="Entrez votre mot de passe"
                                data-session-lock-target="passwordInput"
                                autocomplete="current-password"
                                required
                            >
                        </div>

                        <div
                            data-session-lock-target="errorMessage"
                            class="alert alert-danger d-none mb-3"
                            role="alert"
                        >
                            <i class="fas fa-exclamation-circle me-2"></i>
                            <span></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            <i class="fas fa-unlock me-2"></i> Déverrouiller
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Manual Lock Button Template (will be moved to navbar) -->
    <template data-session-lock-target="lockButtonTemplate">
        <button
            type="button"
            class="btn btn-sm btn-outline-light lock-button-nav"
            title="Verrouiller votre session"
            data-action="session-lock#manualLock"
            id="sessionLockButton"
        >
            <i class="fas fa-lock"></i> <span class="d-none d-lg-inline">Verrouiller</span>
        </button>
    </template>
</div>

<style>
    #sessionLockModal .modal-content {
        border: none;
        border-radius: 0.75rem;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
    }

    #sessionLockModal .modal-body {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(248, 250, 252, 0.95) 100%);
    }

    #sessionLockModal .timer-display {
        background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
        border-radius: 0.5rem;
        padding: 1.5rem;
    }

    #sessionLockModal .alert {
        border: none;
        border-radius: 0.375rem;
    }

    #sessionLockModal .alert.show {
        display: block !important;
    }
</style>
