<aside class="sidebar">
    <div class="sidebar-header">
        <div class="sidebar-logo"><i class="fas fa-map-marker-alt"></i></div>
        <div class="sidebar-title">MTNPDV</div>
    </div>

    <nav class="sidebar-nav">
        {% if app.user.aLeRole('ADMIN') %}
            <div class="nav-section">
                <div class="nav-label">Gestion</div>
                <a href="{{ path('app_admin_dashboard') }}" class="nav-item {% if is_active_route('app_admin_dashboard') %}active{% endif %}">
                    <i class="fas fa-chart-line"></i> Dashboard
                </a>
                <a href="{{ path('app_admin_pdv_list') }}" class="nav-item {% if is_active_route(['app_admin_pdv_list', 'app_admin_pdv_show', 'app_admin_pdv_create', 'app_admin_pdv_edit']) %}active{% endif %}">
                    <i class="fas fa-store"></i> Points de vente
                </a>
                <a href="{{ path('app_admin_utilisateur_list') }}" class="nav-item {% if is_active_route(['app_admin_utilisateur_list', 'app_admin_utilisateur_show', 'app_admin_utilisateur_create', 'app_admin_utilisateur_edit']) %}active{% endif %}">
                    <i class="fas fa-users"></i> Utilisateurs
                </a>
                <a href="{{ path('app_admin_role_list') }}" class="nav-item {% if is_active_route(['app_admin_role_list']) %}active{% endif %}">
                    <i class="fas fa-lock"></i> Rôles
                </a>
            </div>

            <div class="nav-section">
                <div class="nav-label">Suivi</div>
                <a href="{{ path('app_admin_validations') }}" class="nav-item {% if is_active_route('app_admin_validations') %}active{% endif %}">
                    <i class="fas fa-check-circle"></i> Validations
                </a>
                <a href="{{ path('app_admin_map') }}" class="nav-item {% if is_active_route('app_admin_map') %}active{% endif %}">
                    <i class="fas fa-map"></i> Carte
                </a>
            </div>
        {% elseif app.user.aLeRole('AGENT') %}
            <div class="nav-section">
                <a href="{{ path('app_agent_dashboard') }}" class="nav-item {% if is_active_route('app_agent_dashboard') %}active{% endif %}">
                    <i class="fas fa-map-location-dot"></i> Terrain
                </a>
            </div>
        {% elseif app.user.aLeRole('GERANT') %}
            <div class="nav-section">
                <a href="{{ path('app_gerant_dashboard') }}" class="nav-item {% if is_active_route('app_gerant_dashboard') %}active{% endif %}">
                    <i class="fas fa-shop"></i> Mon Kiosque
                </a>
            </div>
        {% endif %}
    </nav>

    <div class="sidebar-footer">
        <a href="{{ path('app_profil_show') }}" class="sidebar-user">
            <div class="user-avatar">{{ app.user.prenomUt[0:1] }}{{ app.user.nomUt[0:1] }}</div>
            <div class="user-info">
                <div class="user-name">{{ app.user.prenomUt }}</div>
                <div class="user-role">
                    {% if app.user.aLeRole('ADMIN') %}
                        Administrateur
                    {% elseif app.user.aLeRole('AGENT') %}
                        Agent
                    {% else %}
                        Gérant
                    {% endif %}
                </div>
            </div>
        </a>
    </div>
</aside>

<style>
