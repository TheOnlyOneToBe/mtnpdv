{# Sidebar Générique Responsive et Compressible #}
<aside class="app-sidebar" id="appSidebar" data-controller="sidebar">
    {# Bouton toggle (visible sur mobile et desktop) #}
    <button class="sidebar-toggle" id="sidebarToggle" title="Afficher/Masquer le menu" data-action="click->sidebar#toggle">
        <i class="fas fa-bars"></i>
    </button>

    {# Header avec logo #}
    <div class="sidebar-header">
        <div class="sidebar-logo">
            <i class="fas fa-map-marker-alt"></i>
        </div>
        <div class="sidebar-title">{{ app_name }}</div>
    </div>

    {# Navigation selon le rôle #}
    <nav class="sidebar-nav">
        {% if app.user.aLeRole('ADMIN') %}
            {# === ADMIN NAVIGATION === #}
            {# Dashboard #}
            <div class="nav-item-wrapper">
                <a href="{{ path('app_admin_dashboard') }}" class="nav-item {% if is_active_route('app_admin_dashboard') %}active{% endif %}" data-action="click->sidebar#closeOnMobile">
                    <i class="fas fa-chart-line"></i>
                    <span class="nav-label">Dashboard</span>
                    <span class="nav-badge"></span>
                </a>
            </div>

            {# Points de Vente #}
            <div class="nav-group">
                <button type="button" class="nav-group-toggle" data-action="sidebar#toggleGroup" data-group="pdv">
                    <i class="fas fa-store"></i>
                    <span class="nav-label">Points de vente</span>
                    <i class="fas fa-chevron-down chevron"></i>
                </button>
                <div class="nav-submenu" id="nav-group-pdv" data-group="pdv">
                    <a href="{{ path('app_admin_pdv_list') }}" class="nav-item {% if is_active_route(['app_admin_pdv_list', 'app_admin_pdv_show', 'app_admin_pdv_create', 'app_admin_pdv_edit']) %}active{% endif %}" data-action="click->sidebar#closeOnMobile">
                        <i class="fas fa-list"></i>
                        <span>Lister</span>
                    </a>
                    <a href="{{ path('app_admin_pdv_create') }}" class="nav-item" data-action="click->sidebar#closeOnMobile">
                        <i class="fas fa-plus-circle"></i>
                        <span>Ajouter un PDV</span>
                    </a>
                </div>
            </div>

            {# Utilisateurs #}
            <div class="nav-group">
                <button type="button" class="nav-group-toggle" data-action="sidebar#toggleGroup" data-group="users">
                    <i class="fas fa-users"></i>
                    <span class="nav-label">Utilisateurs</span>
                    <i class="fas fa-chevron-down chevron"></i>
                </button>
                <div class="nav-submenu" id="nav-group-users" data-group="users">
                    <a href="{{ path('app_admin_utilisateur_list') }}" class="nav-item {% if is_active_route(['app_admin_utilisateur_list', 'app_admin_utilisateur_show', 'app_admin_utilisateur_create', 'app_admin_utilisateur_edit']) %}active{% endif %}" data-action="click->sidebar#closeOnMobile">
                        <i class="fas fa-list"></i>
                        <span>Lister</span>
                    </a>
                    <a href="{{ path('app_admin_utilisateur_create') }}" class="nav-item" data-action="click->sidebar#closeOnMobile">
                        <i class="fas fa-user-plus"></i>
                        <span>Ajouter un utilisateur</span>
                    </a>
                </div>
            </div>

            {# Rôles #}
            <div class="nav-group">
                <button type="button" class="nav-group-toggle" data-action="sidebar#toggleGroup" data-group="roles">
                    <i class="fas fa-shield"></i>
                    <span class="nav-label">Rôles</span>
                    <i class="fas fa-chevron-down chevron"></i>
                </button>
                <div class="nav-submenu" id="nav-group-roles" data-group="roles">
                    <a href="{{ path('app_admin_role_list') }}" class="nav-item {% if is_active_route(['app_admin_role_list', 'app_admin_role_show', 'app_admin_role_edit']) %}active{% endif %}" data-action="click->sidebar#closeOnMobile">
                        <i class="fas fa-list"></i>
                        <span>Lister</span>
                    </a>
                </div>
            </div>

            {# Validations #}
            <div class="nav-item-wrapper">
                <a href="{{ path('app_admin_validations') }}" class="nav-item {% if is_active_route('app_admin_validations') %}active{% endif %}" data-action="click->sidebar#closeOnMobile">
                    <i class="fas fa-check-circle"></i>
                    <span class="nav-label">Validations</span>
                    <span class="nav-badge"></span>
                </a>
            </div>

            {# Carte #}
            <div class="nav-item-wrapper">
                <a href="{{ path('app_admin_map') }}" class="nav-item {% if is_active_route('app_admin_map') %}active{% endif %}" data-action="click->sidebar#closeOnMobile">
                    <i class="fas fa-map"></i>
                    <span class="nav-label">Carte</span>
                    <span class="nav-badge"></span>
                </a>
            </div>

            <div class="nav-item-wrapper">
                <a href="{{ path('app_admin_supervision_index') }}" class="nav-item {% if is_active_route(['app_admin_supervision_index', 'app_admin_supervision_carte', 'app_admin_supervision_transactions', 'app_admin_supervision_agents']) %}active{% endif %}" data-action="click->sidebar#closeOnMobile">
                    <i class="fas fa-binoculars"></i>
                    <span class="nav-label">Supervision</span>
                    <span class="nav-badge"></span>
                </a>
            </div>

            {# Rapports #}
            <div class="nav-group">
                <button type="button" class="nav-group-toggle" data-action="sidebar#toggleGroup" data-group="reports">
                    <i class="fas fa-chart-bar"></i>
                    <span class="nav-label">Rapports</span>
                    <i class="fas fa-chevron-down chevron"></i>
                </button>
                <div class="nav-submenu" id="nav-group-reports" data-group="reports">
                    <a href="{{ path('app_admin_reports') }}" class="nav-item {% if is_active_route('app_admin_reports') %}active{% endif %}" data-action="click->sidebar#closeOnMobile">
                        <i class="fas fa-chart-line"></i>
                        <span>Tableau de bord</span>
                    </a>
                    <a href="{{ path('app_admin_reports_pdv') }}" class="nav-item" data-action="click->sidebar#closeOnMobile">
                        <i class="fas fa-store"></i>
                        <span>Par PDV</span>
                    </a>
                    <a href="{{ path('app_admin_reports_transactions') }}" class="nav-item" data-action="click->sidebar#closeOnMobile">
                        <i class="fas fa-exchange-alt"></i>
                        <span>Transactions</span>
                    </a>
                    <a href="{{ path('app_admin_reports_users') }}" class="nav-item" data-action="click->sidebar#closeOnMobile">
                        <i class="fas fa-users"></i>
                        <span>Utilisateurs</span>
                    </a>
                    <a href="{{ path('app_admin_reports_supervision') }}" class="nav-item" data-action="click->sidebar#closeOnMobile">
                        <i class="fas fa-clipboard-check"></i>
                        <span>Supervision</span>
                    </a>
                </div>
            </div>

            <div class="sidebar-divider"></div>

            {# Paramètres #}
            <div class="nav-group">
                <button type="button" class="nav-group-toggle" data-action="sidebar#toggleGroup" data-group="settings">
                    <i class="fas fa-cog"></i>
                    <span class="nav-label">Paramètres</span>
                    <i class="fas fa-chevron-down chevron"></i>
                </button>
                <div class="nav-submenu" id="nav-group-settings" data-group="settings">
                    <a href="{{ path('app_profil_show') }}" class="nav-item" data-action="click->sidebar#closeOnMobile">
                        <i class="fas fa-user"></i>
                        <span>Mon profil</span>
                    </a>
                    <a href="{{ path('app_profil_change_password') }}" class="nav-item" data-action="click->sidebar#closeOnMobile">
                        <i class="fas fa-key"></i>
                        <span>Mot de passe</span>
                    </a>
                    <a href="{{ path('app_logout') }}" class="nav-item" data-action="click->sidebar#closeOnMobile">
                        <i class="fas fa-sign-out-alt"></i>
                        <span>Déconnexion</span>
                    </a>
                </div>
            </div>

        {% elseif app.user.aLeRole('AGENT') %}
            {# === AGENT NAVIGATION === #}
            <div class="nav-item-wrapper">
                <a href="{{ path('app_agent_dashboard') }}" class="nav-item {% if is_active_route('app_agent_dashboard') %}active{% endif %}" data-action="click->sidebar#closeOnMobile">
                    <i class="fas fa-map-location-dot"></i>
                    <span class="nav-label">Terrain</span>
                    <span class="nav-badge"></span>
                </a>
            </div>

            <div class="nav-group">
                <button type="button" class="nav-group-toggle" data-action="sidebar#toggleGroup" data-group="visites">
                    <i class="fas fa-clipboard-list"></i>
                    <span class="nav-label">Visites</span>
                    <i class="fas fa-chevron-down chevron"></i>
                </button>
                <div class="nav-submenu" id="nav-group-visites" data-group="visites">
                    <a href="{{ path('app_agent_visite_list') }}" class="nav-item {% if is_active_route(['app_agent_visite_list', 'app_agent_visite_show']) %}active{% endif %}" data-action="click->sidebar#closeOnMobile">
                        <i class="fas fa-list"></i>
                        <span>Mes visites</span>
                    </a>
                    <a href="{{ path('app_agent_visite_create') }}" class="nav-item" data-action="click->sidebar#closeOnMobile">
                        <i class="fas fa-plus-circle"></i>
                        <span>Nouvelle visite</span>
                    </a>
                </div>
            </div>

            <div class="sidebar-divider"></div>

            {# Paramètres #}
            <div class="nav-group">
                <button type="button" class="nav-group-toggle" data-action="sidebar#toggleGroup" data-group="settings">
                    <i class="fas fa-cog"></i>
                    <span class="nav-label">Paramètres</span>
                    <i class="fas fa-chevron-down chevron"></i>
                </button>
                <div class="nav-submenu" id="nav-group-settings" data-group="settings">
                    <a href="{{ path('app_profil_show') }}" class="nav-item" data-action="click->sidebar#closeOnMobile">
                        <i class="fas fa-user"></i>
                        <span>Mon profil</span>
                    </a>
                    <a href="{{ path('app_profil_change_password') }}" class="nav-item" data-action="click->sidebar#closeOnMobile">
                        <i class="fas fa-key"></i>
                        <span>Mot de passe</span>
                    </a>
                    <a href="{{ path('app_logout') }}" class="nav-item" data-action="click->sidebar#closeOnMobile">
                        <i class="fas fa-sign-out-alt"></i>
                        <span>Déconnexion</span>
                    </a>
                </div>
            </div>

        {% elseif app.user.aLeRole('GERANT') %}
            {# === GÉRANT NAVIGATION === #}
            <div class="nav-item-wrapper">
                <a href="{{ path('app_gerant_dashboard') }}" class="nav-item {% if is_active_route('app_gerant_dashboard') %}active{% endif %}" data-action="click->sidebar#closeOnMobile">
                    <i class="fas fa-shop"></i>
                    <span class="nav-label">Mon Kiosque</span>
                    <span class="nav-badge"></span>
                </a>
            </div>

            <div class="nav-item-wrapper">
                <a href="{{ path('app_gerant_produits_list') }}" class="nav-item {% if is_active_route('app_gerant_produits_list') %}active{% endif %}" data-action="click->sidebar#closeOnMobile">
                    <i class="fas fa-boxes"></i>
                    <span class="nav-label">Mes produits</span>
                    <span class="nav-badge"></span>
                </a>
            </div>

            <div class="nav-item-wrapper">
                <a href="{{ path('app_gerant_transactions') }}" class="nav-item {% if is_active_route('app_gerant_transactions') %}active{% endif %}" data-action="click->sidebar#closeOnMobile">
                    <i class="fas fa-exchange-alt"></i>
                    <span class="nav-label">Transactions</span>
                    <span class="nav-badge"></span>
                </a>
            </div>

            <div class="sidebar-divider"></div>

            {# Paramètres #}
            <div class="nav-group">
                <button type="button" class="nav-group-toggle" data-action="sidebar#toggleGroup" data-group="settings">
                    <i class="fas fa-cog"></i>
                    <span class="nav-label">Paramètres</span>
                    <i class="fas fa-chevron-down chevron"></i>
                </button>
                <div class="nav-submenu" id="nav-group-settings" data-group="settings">
                    <a href="{{ path('app_profil_show') }}" class="nav-item" data-action="click->sidebar#closeOnMobile">
                        <i class="fas fa-user"></i>
                        <span>Mon profil</span>
                    </a>
                    <a href="{{ path('app_profil_change_password') }}" class="nav-item" data-action="click->sidebar#closeOnMobile">
                        <i class="fas fa-key"></i>
                        <span>Mot de passe</span>
                    </a>
                    <a href="{{ path('app_logout') }}" class="nav-item" data-action="click->sidebar#closeOnMobile">
                        <i class="fas fa-sign-out-alt"></i>
                        <span>Déconnexion</span>
                    </a>
                </div>
            </div>
        {% endif %}
    </nav>

    {# Sidebar Footer avec infos utilisateur #}
    <div class="sidebar-footer">
        <div class="user-card">
            <div class="user-avatar">
                {% if app.user.photoProfilUrl %}
                    <img src="{{ app.user.photoProfilUrl }}" alt="{{ app.user.prenomUt }}" class="user-photo">
                {% else %}
                    <div class="user-initials">{{ app.user.prenomUt[0:1] }}{{ app.user.nomUt[0:1] }}</div>
                {% endif %}
            </div>
            <div class="user-details">
                <div class="user-name">{{ app.user.prenomUt }} {{ app.user.nomUt }}</div>
                <div class="user-role">
                    {% if app.user.aLeRole('ADMIN') %}Administrateur
                    {% elseif app.user.aLeRole('AGENT') %}Agent
                    {% else %}Gérant{% endif %}
                </div>
            </div>
        </div>
    </div>
</aside>

<style>
.app-sidebar {
    position: fixed;
    left: 0;
    top: 60px;
    width: 280px;
    height: calc(100vh - 60px);
    background: linear-gradient(180deg, #ffffff 0%, #fafafa 100%);
    border-right: 2px solid #fde047;
    box-shadow: 2px 0 12px rgba(0, 0, 0, 0.08);
    overflow-y: auto;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.app-sidebar.collapsed {
    transform: translateX(-280px);
}

.sidebar-toggle {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 1010;
    background: #fde047 !important;
    color: #333 !important;
    border: none !important;
    border-radius: 0.375rem;
    padding: 0.5rem 0.75rem;
    cursor: pointer;
    transition: all 0.2s;
    display: none;
}

.sidebar-toggle:hover {
    background: #fbbf24 !important;
    transform: scale(1.05);
}

.sidebar-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 1.25rem 1.5rem;
    border-bottom: 2px solid #fde047;
    background: linear-gradient(90deg, rgba(253, 224, 71, 0.05) 0%, transparent 100%);
    flex-shrink: 0;
}

.sidebar-logo {
    font-size: 1.5rem;
    color: #fde047;
    display: flex;
    align-items: center;
    justify-content: center;
}

.sidebar-title {
    font-weight: 700;
    font-size: 1rem;
    color: #333;
    white-space: nowrap;
}

.sidebar-nav {
    flex: 1;
    padding: 1rem 0;
    overflow-y: auto;
    overflow-x: hidden;
}

.sidebar-nav::-webkit-scrollbar {
    width: 6px;
}

.sidebar-nav::-webkit-scrollbar-track {
    background: transparent;
}

.sidebar-nav::-webkit-scrollbar-thumb {
    background: #fde047;
    border-radius: 3px;
}

.sidebar-nav::-webkit-scrollbar-thumb:hover {
    background: #fbbf24;
}

.nav-item-wrapper,
.nav-group {
    margin-bottom: 0.25rem;
}

.nav-item,
.nav-group-toggle {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 10px 1.5rem;
    text-decoration: none;
    color: #555;
    font-size: 0.9375rem;
    font-weight: 500;
    border: none;
    background: transparent;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: left;
}

.nav-item:hover,
.nav-group-toggle:hover {
    background: #fffacd;
    color: #333;
}

.nav-item.active {
    background: #fde047;
    color: #333;
    border-left: 4px solid #d97706;
    font-weight: 600;
}

.nav-item i:first-child,
.nav-group-toggle i:first-child {
    width: 20px;
    text-align: center;
    color: #fde047;
    font-size: 0.95rem;
    flex-shrink: 0;
}

.nav-item.active i:first-child {
    color: #d97706;
}

.nav-label {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.nav-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 4px;
    background: #ef4444;
    color: white;
    border-radius: 9999px;
    font-size: 0.7rem;
    font-weight: 700;
}

.nav-group-toggle {
    justify-content: space-between;
}

.chevron {
    font-size: 0.75rem;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    flex-shrink: 0;
    color: #999 !important;
}

.nav-submenu {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    background: rgba(253, 224, 71, 0.05);
    display: flex;
    flex-direction: column;
}

.nav-submenu.open {
    max-height: 500px;
}

.nav-submenu .nav-item {
    padding-left: 3.5rem;
    font-size: 0.875rem;
    color: #777;
}

.nav-submenu .nav-item:hover {
    background: #fffacd;
    color: #333;
}

.nav-submenu .nav-item.active {
    background: #ffe082;
    color: #333;
    border-left-color: #d97706;
}

.sidebar-divider {
    height: 1px;
    background: linear-gradient(to right, transparent, #fde047, transparent);
    margin: 1rem 1.5rem;
}

.sidebar-footer {
    padding: 1rem 1.5rem;
    border-top: 2px solid #fde047;
    background: linear-gradient(180deg, rgba(253, 224, 71, 0.05) 0%, rgba(253, 224, 71, 0.02) 100%);
    flex-shrink: 0;
}

.user-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0.75rem;
    background: white;
    border-radius: 0.5rem;
    border: 1px solid #fde047;
}

.user-avatar {
    width: 40px;
    height: 40px;
    border-radius: 0.375rem;
    overflow: hidden;
    background: linear-gradient(135deg, #fde047, #fbbf24);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-weight: 700;
    color: #333;
}

.user-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.user-initials {
    font-size: 0.875rem;
}

.user-details {
    flex: 1;
    min-width: 0;
}

.user-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: #333;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.user-role {
    font-size: 0.75rem;
    color: #999;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ========== RESPONSIVE ========== */

/* Tablet / Desktop petit */
@media (max-width: 1280px) {
    .app-sidebar {
        width: 240px;
    }

    .app-sidebar.collapsed {
        transform: translateX(-240px);
    }
}

/* Tablette */
@media (max-width: 1024px) {
    .app-sidebar {
        width: 220px;
    }

    .app-sidebar.collapsed {
        transform: translateX(-220px);
    }

    .sidebar-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .nav-item,
    .nav-group-toggle {
        font-size: 0.875rem;
        padding: 9px 1.25rem;
    }

    .sidebar-header {
        padding: 1rem 1.25rem;
    }
}

/* Mobile */
@media (max-width: 768px) {
    .app-sidebar {
        width: 100%;
        transform: translateX(-100%);
    }

    .app-sidebar.open {
        transform: translateX(0);
    }

    .app-sidebar.collapsed {
        transform: translateX(-100%);
    }

    .sidebar-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .sidebar-nav {
        padding-top: 3rem;
    }

    .nav-item,
    .nav-group-toggle {
        padding: 12px 1.5rem;
        font-size: 0.9375rem;
    }

    .sidebar-header {
        padding: 1rem 1.5rem;
    }

    .sidebar-footer {
        padding: 1rem 1.5rem;
    }
}

/* Ajustement du contenu principal */
main {
    margin-left: 280px;
    transition: margin-left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

@media (max-width: 1280px) {
    main {
        margin-left: 240px;
    }
}

@media (max-width: 1024px) {
    main {
        margin-left: 220px;
    }
}

@media (max-width: 768px) {
    main {
        margin-left: 0;
    }
}
</style>


