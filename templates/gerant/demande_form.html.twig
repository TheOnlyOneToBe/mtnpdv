{% extends 'base.html.twig' %}

{% block title %}Nouvelle demande - {{ app_name }}{% endblock %}

{% block body %}
    <div class="container-lg py-4">
        <div class="row">
            <div class="col-md-8 mx-auto">
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="fas fa-plus-circle"></i> Nouvelle demande de mission</h5>
                    </div>
                    <div class="card-body">
                        {{ form_start(form) }}
                            {{ form_row(form.type) }}
                            {{ form_row(form.montant) }}
                            {{ form_row(form.motif) }}
                            {{ form_row(form.description) }}
                            {% if form.pointVente is defined %}
                                {{ form_row(form.pointVente) }}
                            {% endif %}
                            {% if form.agent is defined %}
                                {{ form_row(form.agent) }}
                            {% endif %}
                            {{ form_rest(form) }}
                            <div class="d-flex justify-content-end mt-4">
                                <a href="{{ path('app_gerant_dashboard') }}" class="btn btn-secondary me-2">
                                    <i class="fas fa-arrow-left"></i> Retour
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> Enregistrer
                                </button>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

