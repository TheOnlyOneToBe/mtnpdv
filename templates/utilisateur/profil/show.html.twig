{% extends 'base.html.twig' %}

{% block title %}Mon profil - {{ app_name }}{% endblock %}

{% block body %}
    <div class="container-lg py-5">
        <div class="row mb-4">
            <div class="col-md-8">
                <h1 class="mb-2"><i class="fas fa-user-circle"></i> Mon profil</h1>
                <p class="text-muted">Consultez et gérez vos informations personnelles</p>
            </div>
            <div class="col-md-4 text-end">
                <a href="{{ path('app_profil_edit') }}" class="btn btn-primary">
                    <i class="fas fa-edit"></i> Modifier le profil
                </a>
            </div>
        </div>

        <div class="row">
            <div class="col-md-8">
                <!-- Informations personnelles -->
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="fas fa-id-card"></i> Informations personnelles</h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="text-muted small">Prénom</label>
                                <p class="h6">{{ utilisateur.prenomUt }}</p>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted small">Nom</label>
                                <p class="h6">{{ utilisateur.nomUt }}</p>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="text-muted small">E-mail</label>
                            <p class="h6">
                                <i class="fas fa-envelope text-primary"></i> {{ utilisateur.email.value }}
                            </p>
                        </div>

                        <div class="mb-3">
                            <label class="text-muted small">Téléphone</label>
                            <p class="h6">
                                <i class="fas fa-phone text-success"></i> {{ utilisateur.telephone.value }}
                            </p>
                        </div>

                        <div class="row text-center">
                            <div class="col-md-6">
                                <a href="{{ path('app_profil_edit') }}" class="btn btn-outline-primary w-100">
                                    <i class="fas fa-edit"></i> Modifier les informations
                                </a>
                            </div>
                            <div class="col-md-6">
                                <a href="{{ path('app_profil_change_password') }}" class="btn btn-outline-warning w-100">
                                    <i class="fas fa-key"></i> Changer le mot de passe
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Rôles et permissions -->
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="fas fa-shield"></i> Rôles et permissions</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small mb-3">Vos rôles dans le système déterminent vos permissions d'accès.</p>
                        <div>
                            {% for role in utilisateur.rolesEntites %}
                                <span class="badge bg-primary me-2 mb-2 p-2">
                                    <i class="fas fa-shield-halved"></i> {{ role.libelle }}
                                </span>
                            {% endfor %}
                        </div>
                        <small class="text-muted d-block mt-3">
                            Pour modifier vos rôles, veuillez contacter un administrateur.
                        </small>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <!-- Statut du compte -->
                <div class="card mb-4 border-success">
                    <div class="card-header bg-success text-white">
                        <h6 class="mb-0"><i class="fas fa-check-circle"></i> Statut du compte</h6>
                    </div>
                    <div class="card-body">
                        {% if utilisateur.statut.value == 'ACTIF' %}
                            <span class="badge bg-success me-2"><i class="fas fa-check-circle"></i> Actif</span>
                            <p class="small text-muted">Votre compte est actif et vous pouvez vous connecter.</p>
                        {% else %}
                            <span class="badge bg-danger me-2"><i class="fas fa-times-circle"></i> Inactif</span>
                            <p class="small text-muted">Votre compte est actuellement désactivé. Contactez un administrateur.</p>
                        {% endif %}
                    </div>
                </div>

                <!-- Informations de compte -->
                <div class="card">
                    <div class="card-header bg-light">
                        <h6 class="mb-0"><i class="fas fa-history"></i> Historique du compte</h6>
                    </div>
                    <div class="card-body">
                        <p class="small mb-2">
                            <strong>Inscrit depuis:</strong><br>
                            {{ utilisateur.dateCreation.format('d M Y à H:i') }}
                        </p>
                    </div>
                </div>

                <!-- Sécurité -->
                <div class="card mt-4 border-warning">
                    <div class="card-header bg-warning text-white">
                        <h6 class="mb-0"><i class="fas fa-lock"></i> Sécurité</h6>
                    </div>
                    <div class="card-body">
                        <p class="small text-muted mb-3">
                            Pour votre sécurité, nous vous recommandons de changer votre mot de passe régulièrement.
                        </p>
                        <a href="{{ path('app_profil_change_password') }}" class="btn btn-warning btn-sm w-100">
                            <i class="fas fa-key"></i> Changer le mot de passe
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
