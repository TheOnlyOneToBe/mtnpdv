<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Rapport d'Activité</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 11pt;
            line-height: 1.4;
            color: #333;
            margin: 0;
            padding: 20px;
        }
        .header {
            border-bottom: 3px solid #1e40af;
            margin-bottom: 20px;
            padding-bottom: 15px;
            text-align: center;
        }
        .header h1 {
            margin: 0;
            color: #1e40af;
            font-size: 24pt;
        }
        .header p {
            margin: 5px 0;
            color: #666;
        }
        .section {
            margin-bottom: 25px;
            page-break-inside: avoid;
        }
        .section h2 {
            background-color: #f0f4f8;
            border-left: 4px solid #1e40af;
            padding: 10px 15px;
            margin: 0 0 15px 0;
            font-size: 14pt;
            color: #1e40af;
        }
        .stats {
            display: flex;
            justify-content: space-around;
            margin: 20px 0;
            flex-wrap: wrap;
        }
        .stat-box {
            border: 1px solid #e0e0e0;
            border-radius: 4px;
            padding: 15px;
            text-align: center;
            width: 22%;
            margin: 5px;
        }
        .stat-box strong {
            display: block;
            color: #1e40af;
            font-size: 18pt;
            margin: 10px 0 5px 0;
        }
        .stat-label {
            color: #666;
            font-size: 10pt;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin: 15px 0;
        }
        table th {
            background-color: #1e40af;
            color: white;
            padding: 10px;
            text-align: left;
            font-weight: bold;
            font-size: 10pt;
        }
        table td {
            border-bottom: 1px solid #ddd;
            padding: 8px 10px;
            font-size: 10pt;
        }
        table tr:nth-child(even) {
            background-color: #f9f9f9;
        }
        .footer {
            border-top: 1px solid #ddd;
            margin-top: 30px;
            padding-top: 15px;
            text-align: center;
            font-size: 9pt;
            color: #999;
        }
        .generated-at {
            color: #999;
            font-size: 9pt;
            text-align: right;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>📊 Rapport d'Activité</h1>
        <p>Ensemble des transactions enregistrées</p>
        <div class="generated-at">Généré le {{ generatedAt.format('d/m/Y à H:i') }}</div>
    </div>

    <div class="section">
        <h2>Résumé</h2>
        {% set visites = transactions|filter(t => t.getType.name == 'VISITE') %}
        {% set ventes = transactions|filter(t => t.getType.name == 'VENTE') %}
        {% set totalMontant = ventes|reduce((carry, t) => carry + t.getMontant.centimes, 0) %}
        <div class="stats">
            <div class="stat-box">
                <span class="stat-label">Transactions</span>
                <strong>{{ transactions|length }}</strong>
            </div>
            <div class="stat-box">
                <span class="stat-label">Visites</span>
                <strong>{{ visites|length }}</strong>
            </div>
            <div class="stat-box">
                <span class="stat-label">Ventes</span>
                <strong>{{ ventes|length }}</strong>
            </div>
            <div class="stat-box">
                <span class="stat-label">Chiffre d'Affaires</span>
                <strong>{{ (totalMontant / 100)|number_format(0, ',', ' ') }} FCFA</strong>
            </div>
        </div>
    </div>

    <div class="section">
        <h2>Transactions par Type</h2>
        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Statut</th>
                    <th>Montant (FCFA)</th>
                    <th>Point Vente</th>
                    <th>Agent</th>
                </tr>
            </thead>
            <tbody>
                {% for transaction in transactions %}
                <tr>
                    <td>{{ transaction.getDateTransac.format('d/m/Y H:i') }}</td>
                    <td>{{ transaction.getType.name }}</td>
                    <td>{{ transaction.getStatut.name }}</td>
                    <td style="text-align: right;">{{ (transaction.getMontant.centimes / 100)|number_format(0, ',', ' ') }}</td>
                    <td>{{ transaction.getPointVente.getNomPdv ?? 'N/A' }}</td>
                    <td>{{ transaction.getUtilisateur.getNomComplet ?? 'N/A' }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="footer">
        <p>Rapport généré automatiquement par le système de gestion des points de vente.</p>
    </div>
</body>
</html>
