<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Détail Visite</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 11pt;
            line-height: 1.4;
            color: #333;
            margin: 0;
            padding: 20px;
        }
        .header {
            border-bottom: 3px solid #FCD34D;
            margin-bottom: 20px;
            padding-bottom: 15px;
            text-align: center;
        }
        .header h1 {
            margin: 0;
            color: #FCD34D;
            font-size: 24pt;
        }
        .header p {
            margin: 5px 0;
            color: #666;
        }
        .section {
            margin-bottom: 20px;
            page-break-inside: avoid;
        }
        .section h2 {
            background-color: #f0f4f8;
            border-left: 4px solid #FCD34D;
            padding: 10px 15px;
            margin: 0 0 15px 0;
            font-size: 14pt;
            color: #FCD34D;
        }
        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin: 15px 0;
        }
        .info-item {
            border: 1px solid #e0e0e0;
            padding: 10px;
            border-radius: 4px;
        }
        .info-label {
            color: #666;
            font-size: 10pt;
            font-weight: bold;
            margin-bottom: 5px;
        }
        .info-value {
            color: #333;
            font-size: 11pt;
            font-weight: 500;
        }
        .status-badge {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 3px;
            font-weight: bold;
            font-size: 10pt;
            margin-top: 5px;
        }
        .status-en_attente {
            background-color: #fef3c7;
            color: #92400e;
        }
        .status-validee {
            background-color: #dcfce7;
            color: #166534;
        }
        .status-rejetee {
            background-color: #fee2e2;
            color: #991b1b;
        }
        .photo-section {
            margin: 20px 0;
            text-align: center;
        }
        .photo-section img {
            max-width: 100%;
            height: auto;
            border: 1px solid #ddd;
            border-radius: 4px;
            max-height: 400px;
        }
        .footer {
            border-top: 1px solid #ddd;
            margin-top: 30px;
            padding-top: 15px;
            text-align: center;
            font-size: 9pt;
            color: #999;
        }
        .generated-at {
            color: #999;
            font-size: 9pt;
            text-align: right;
            margin-bottom: 20px;
        }
        .location-info {
            background-color: #f0f4f8;
            padding: 10px;
            border-radius: 4px;
            margin-top: 10px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>📋 Détail de Visite</h1>
        <p>Visite #{{ visite.getId }}</p>
        <div class="generated-at">Généré le {{ generatedAt.format('d/m/Y à H:i') }}</div>
    </div>

    <div class="section">
        <h2>Informations Générales</h2>
        <div class="info-grid">
            <div class="info-item">
                <div class="info-label">Type de Transaction</div>
                <div class="info-value">{{ visite.getType.name }}</div>
            </div>
            <div class="info-item">
                <div class="info-label">Statut</div>
                <div class="info-value">
                    <span class="status-badge status-{{ visite.getStatut.name|lower }}">
                        {{ visite.getStatut.name }}
                    </span>
                </div>
            </div>
            <div class="info-item">
                <div class="info-label">Date</div>
                <div class="info-value">{{ visite.getDateTransac.format('d/m/Y H:i') }}</div>
            </div>
            <div class="info-item">
                <div class="info-label">Montant</div>
                <div class="info-value">{{ (visite.getMontant.centimes / 100)|number_format(0, ',', ' ') }} FCFA</div>
            </div>
        </div>
    </div>

    <div class="section">
        <h2>Point de Vente</h2>
        {% set pdv = visite.getPointVente %}
        <div class="info-grid">
            <div class="info-item">
                <div class="info-label">Nom du Kiosque</div>
                <div class="info-value">{{ pdv.getNomPdv }}</div>
            </div>
            <div class="info-item">
                <div class="info-label">Code Référence</div>
                <div class="info-value">{{ pdv.getCodeRef }}</div>
            </div>
            <div class="info-item">
                <div class="info-label">Localité</div>
                <div class="info-value">{{ pdv.getLocalite }}</div>
            </div>
            <div class="info-item">
                <div class="info-label">Responsable</div>
                <div class="info-value">{{ pdv.getUtilisateur.getNomComplet ?? 'N/A' }}</div>
            </div>
        </div>
        {% set coords = pdv.getCoordonneesGps %}
        <div class="location-info">
            <strong>Coordonnées GPS:</strong> {{ coords.latitude|number_format(6, '.', '') }}, {{ coords.longitude|number_format(6, '.', '') }}
        </div>
    </div>

    <div class="section">
        <h2>Agent</h2>
        {% set agent = visite.getUtilisateur %}
        <div class="info-grid">
            <div class="info-item">
                <div class="info-label">Nom Complet</div>
                <div class="info-value">{{ agent.getNomComplet }}</div>
            </div>
            <div class="info-item">
                <div class="info-label">Email</div>
                <div class="info-value">{{ agent.getEmail.toString }}</div>
            </div>
            <div class="info-item">
                <div class="info-label">Téléphone</div>
                <div class="info-value">{{ agent.getTelephone.toString }}</div>
            </div>
            <div class="info-item">
                <div class="info-label">Rôle</div>
                <div class="info-value">{{ agent.getRoles|join(', ') }}</div>
            </div>
        </div>
    </div>

    {% if visite.getCommentaire %}
    <div class="section">
        <h2>Commentaire</h2>
        <div style="background-color: #f9f9f9; padding: 15px; border-left: 3px solid #FCD34D; border-radius: 4px;">
            {{ visite.getCommentaire }}
        </div>
    </div>
    {% endif %}

    {% if visite.getPhotoPreuveUrl %}
    <div class="section">
        <h2>Photo de Preuve</h2>
        <div class="photo-section">
            <img src="{{ visite.getPhotoPreuveUrl }}" alt="Photo de preuve">
        </div>
    </div>
    {% endif %}

    <div class="footer">
        <p>Document généré automatiquement par le système de gestion des points de vente.</p>
    </div>
</body>
</html>
