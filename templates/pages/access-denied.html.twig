{% extends 'base.html.twig' %}

{% block title %}Accès Refusé - {{ parent() }}{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="alert alert-danger text-center" style="border-radius: 15px; padding: 40px 20px;">
                <i class="fas fa-lock" style="font-size: 60px; margin-bottom: 20px;"></i>

                <h2 class="mt-3 mb-2">Accès Refusé</h2>
                <p class="text-muted">Vous n'avez pas les permissions pour accéder à cette ressource.</p>

                <div class="mt-4" style="background: rgba(0,0,0,0.05); padding: 20px; border-radius: 10px;">
                    <p style="font-size: 14px; color: #666; margin-bottom: 15px;">
                        <strong>Raison:</strong> {{ reason|default('Permissions insuffisantes') }}
                    </p>
                    <p style="font-size: 12px; color: #999; margin: 0;">
                        Seuls les utilisateurs autorisés peuvent accéder à cette page.
                        Si vous pensez qu'il s'agit d'une erreur, veuillez contacter l'administrateur.
                    </p>
                </div>

                <div class="mt-4">
                    <a href="{{ path('app_accueil') }}" class="btn btn-primary me-2">
                        <i class="fas fa-home"></i> Retour à l'accueil
                    </a>
                    <a href="javascript:history.back()" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Retour précédent
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
