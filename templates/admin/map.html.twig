{% extends 'base.html.twig' %}

{% block title %}Carte des points de vente - {{ app_name }}{% endblock %}

{% block body %}
    <div data-controller="pdv-map"
         data-pdv-map-points-value="{{ pointVentesData|json_encode }}">
        <div class="container-lg py-4">
            <div class="row mb-4">
                <div class="col-md-12">
                    <h1 class="mb-2"><i class="fas fa-map"></i> Carte interactive</h1>
                    <p class="text-muted">Visualisez tous les points de vente sur la carte</p>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex gap-4 justify-content-center">
                                <div class="d-flex align-items-center gap-2">
                                    <span style="display: inline-block; width: 20px; height: 20px; background-color: #16a34a; border-radius: 50%;"></span>
                                    <span>PDV opérationnel</span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span style="display: inline-block; width: 20px; height: 20px; background-color: #ff5252; border-radius: 50%;"></span>
                                    <span>Seuil minimal atteint</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-body" style="padding: 0;" data-pdv-map-target="mapContainer">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

