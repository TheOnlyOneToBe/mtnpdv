{% extends 'base.html.twig' %}

{% block title %}Approvisionnements - {{ app_name }}{% endblock %}

{% block body %}
    <div class="container-lg py-4">
        <!-- Header -->
        <div class="row mb-4">
            <div class="col-md-6">
                <h1 class="mb-2"><i class="fas fa-truck"></i> Approvisionnements</h1>
                <p class="text-muted">Gérez les demandes d'approvisionnement</p>
            </div>
            <div class="col-md-6 text-end">
                <a href="{{ path('app_admin_approvisionnement_create') }}" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Nouvelle demande
                </a>
            </div>
        </div>

        <!-- Liste des approvisionnements -->
        <div class="card">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="fas fa-list"></i> Liste des demandes</h5>
            </div>
            <div class="card-body">
                {% if approvisionnements|length > 0 %}
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Point de vente</th>
                                    <th>Montant</th>
                                    <th>Date</th>
                                    <th>Statut</th>
                                    <th>Agent</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for approvisionnement in approvisionnements %}
                                    <tr>
                                        <td>
                                            {% if approvisionnement.pointVente %}
                                                <strong>{{ approvisionnement.pointVente.nomPdv }}</strong>
                                            {% else %}
                                                <span class="text-muted">Point de vente supprimé</span>
                                            {% endif %}
                                        </td>
                                        <td>{{ approvisionnement.montant.toDecimal() }}</td>
                                        <td>{{ approvisionnement.dateTransac|date('d/m/Y H:i') }}</td>
                                        <td>
                                            <span class="badge bg-{% if approvisionnement.statut.value == 'EN_ATTENTE' %}secondary{% elseif approvisionnement.statut.value == 'RECU_PAR_AGENT' %}info{% elseif approvisionnement.statut.value == 'TERMINEE' %}success{% else %}danger{% endif %}">
                                                {{ approvisionnement.statut.libelle() }}
                                            </span>
                                        </td>
                                        <td>
                                            {% if approvisionnement.agent %}
                                                {{ approvisionnement.agent.nomComplet }}
                                            {% else %}
                                                <span class="text-muted">-</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <a href="{{ path('app_agent_visite_show', {id: approvisionnement.id}) }}" class="btn btn-sm btn-info">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            {% if approvisionnement.statut.value == 'RECU_PAR_AGENT' %}
                                                <form method="POST" action="{{ path('app_admin_approvisionnement_terminer', {id: approvisionnement.id}) }}" style="display: inline;">
                                                    <button type="submit" class="btn btn-sm btn-success">
                                                        <i class="fas fa-check"></i> Terminer
                                                    </button>
                                                </form>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    {% if pagination.totalPages > 1 %}
                        <nav aria-label="Pagination" class="mt-4">
                            <ul class="pagination justify-content-center">
                                {% if pagination.hasPreviousPage %}
                                    <li class="page-item">
                                        <a class="page-link" href="{{ path('app_admin_approvisionnement_list', {page: 1}) }}">
                                            <i class="fas fa-step-backward"></i>
                                        </a>
                                    </li>
                                    <li class="page-item">
                                        <a class="page-link" href="{{ path('app_admin_approvisionnement_list', {page: pagination.currentPage - 1}) }}">
                                            <i class="fas fa-chevron-left"></i>
                                        </a>
                                    </li>
                                {% else %}
                                    <li class="page-item disabled">
                                        <span class="page-link"><i class="fas fa-step-backward"></i></span>
                                    </li>
                                    <li class="page-item disabled">
                                        <span class="page-link"><i class="fas fa-chevron-left"></i></span>
                                    </li>
                                {% endif %}

                                {% for page in range(1, pagination.totalPages) %}
                                    {% if page == pagination.currentPage %}
                                        <li class="page-item active">
                                            <span class="page-link">{{ page }}</span>
                                        </li>
                                    {% else %}
                                        <li class="page-item">
                                            <a class="page-link" href="{{ path('app_admin_approvisionnement_list', {page: page}) }}">{{ page }}</a>
                                        </li>
                                    {% endif %}
                                {% endfor %}

                                {% if pagination.hasNextPage %}
                                    <li class="page-item">
                                        <a class="page-link" href="{{ path('app_admin_approvisionnement_list', {page: pagination.currentPage + 1}) }}">
                                            <i class="fas fa-chevron-right"></i>
                                        </a>
                                    </li>
                                    <li class="page-item">
                                        <a class="page-link" href="{{ path('app_admin_approvisionnement_list', {page: pagination.totalPages}) }}">
                                            <i class="fas fa-step-forward"></i>
                                        </a>
                                    </li>
                                {% else %}
                                    <li class="page-item disabled">
                                        <span class="page-link"><i class="fas fa-chevron-right"></i></span>
                                    </li>
                                    <li class="page-item disabled">
                                        <span class="page-link"><i class="fas fa-step-forward"></i></span>
                                    </li>
                                {% endif %}
                            </ul>
                        </nav>
                    {% endif %}
                {% else %}
                    <div class="text-center py-4">
                        <i class="fas fa-inbox fa-3x text-muted mb-2"></i>
                        <p class="text-muted">Aucune demande d'approvisionnement.</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
