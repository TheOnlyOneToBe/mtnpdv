{% extends 'base.html.twig' %}

{% block title %}Détail du produit{% endblock %}

{% block body %}
<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Détail du produit</h1>
    <div class="d-flex gap-2">
      <a href="{{ path('app_admin_produit_list') }}" class="btn btn-outline-secondary">Retour à la liste</a>
      <a href="{{ path('app_admin_produit_edit', {id: produit.id}) }}" class="btn btn-outline-warning">Modifier</a>
    </div>
  </div>

  <div class="card">
    <div class="card-body">
      <dl class="row">
        <dt class="col-sm-3">ID</dt>
        <dd class="col-sm-9">{{ produit.id }}</dd>

        <dt class="col-sm-3">Nom</dt>
        <dd class="col-sm-9">{{ produit.nomProduit }}</dd>

        <dt class="col-sm-3">Type</dt>
        <dd class="col-sm-9">{{ produit.typePro }}</dd>

        <dt class="col-sm-3">Prix unitaire</dt>
        <dd class="col-sm-9">{{ produit.prix.toDecimal() }} FCFA</dd>

        <dt class="col-sm-3">Statut</dt>
        <dd class="col-sm-9">
          <span class="badge {% if produit.statutProd.estActif() %}bg-success{% else %}bg-secondary{% endif %}">
            {{ produit.statutProd.libelle }}
          </span>
        </dd>

        <dt class="col-sm-3">Catégorie</dt>
        <dd class="col-sm-9">{{ produit.categorieProduit ? produit.categorieProduit.libelle : '-' }}</dd>

        <dt class="col-sm-3">Code-barres</dt>
        <dd class="col-sm-9">{{ produit.codeBarre ?: '-' }}</dd>
      </dl>
    </div>
  </div>
</div>
{% endblock %}
