{% extends 'base.html.twig' %}

{% block title %}Gestion des produits{% endblock %}

{% block body %}
<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Produits</h1>
    <a href="{{ path('app_admin_produit_create') }}" class="btn btn-primary">Ajouter un produit</a>
  </div>

  {% for message in app.flashes('success') %}
    <div class="alert alert-success">{{ message }}</div>
  {% endfor %}
  {% for message in app.flashes('danger') %}
    <div class="alert alert-danger">{{ message }}</div>
  {% endfor %}

  <div class="card mb-3">
    <div class="card-body">
      <form method="get" action="{{ path('app_admin_produit_list') }}" class="row g-3">
        <div class="col-md-6">
          <input type="text" name="q" class="form-control" placeholder="Rechercher un produit..." value="{{ q }}">
        </div>
        <div class="col-md-4">
          <select name="statut" class="form-select">
            <option value="">Tous les statuts</option>
            {% for statut in statuts %}
              <option value="{{ statut.value }}" {% if statutSelectionne is not null and statut.value == statutSelectionne %}selected{% endif %}>{{ statut.libelle }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="col-md-2 d-grid">
          <button type="submit" class="btn btn-secondary">Filtrer</button>
        </div>
      </form>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-hover">
      <thead>
        <tr>
          <th>ID</th>
          <th>Nom</th>
          <th>Type</th>
          <th>Prix unitaire</th>
          <th>Statut</th>
          <th>Catégorie</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for produit in produits %}
          <tr>
            <td>{{ produit.id }}</td>
            <td>{{ produit.nomProduit }}</td>
            <td>{{ produit.typePro }}</td>
            <td>{{ produit.prix.toDecimal() }} FCFA</td>
            <td>
              <span class="badge {% if produit.statutProd.estActif() %}bg-success{% else %}bg-secondary{% endif %}">
                {{ produit.statutProd.libelle }}
              </span>
            </td>
            <td>{{ produit.categorieProduit ? produit.categorieProduit.libelle : '-' }}</td>
            <td class="text-end">
              <a href="{{ path('app_admin_produit_show', {id: produit.id}) }}" class="btn btn-sm btn-outline-primary">Voir</a>
              <a href="{{ path('app_admin_produit_edit', {id: produit.id}) }}" class="btn btn-sm btn-outline-warning">Modifier</a>
              <form method="post" action="{{ path('app_admin_produit_delete', {id: produit.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer ce produit ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete-produit-' ~ produit.id) }}">
                <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
              </form>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="7" class="text-center text-muted">Aucun produit trouvé.</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  {% if pagination.totalPages > 1 %}
 <nav class="mt-3">
      <ul class="pagination">
        {% for page in 1..pagination.totalPages %}
          <li class="page-item {% if page == pagination.current %}active{% endif %}">
            <a class="page-link" href="{{ path('app_admin_produit_list', {page: page, q: q, statut: statutSelectionne}) }}">{{ page }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  {% endif %}
</div>
{% endblock %}
