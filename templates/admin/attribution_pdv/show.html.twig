{% extends 'base.html.twig' %}

{% block title %}Détail de l'attribution{% endblock %}

{% block body %}
<div class="container">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Détail de l'attribution</h1>
    <div>
      <a href="{{ path('app_admin_attribution_list') }}" class="btn btn-secondary">Retour à la liste</a>
      <a href="{{ path('app_admin_attribution_edit', {id: attribution.id}) }}" class="btn btn-warning ms-2">Modifier</a>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-body">
      <h6 class="text-uppercase text-muted mb-3">Attribution</h6>
      <div class="row g-3">
        <div class="col-md-3">
          <div class="p-3 border rounded h-100">
            <div class="text-muted small">ID</div>
            <div class="fw-semibold">{{ attribution.id }}</div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="p-3 border rounded h-100">
            <div class="text-muted small">Statut</div>
            <div>
              {% if attribution.isActif() %}
                <span class="badge bg-success">Active</span>
              {% else %}
                <span class="badge bg-danger">Révoquée</span>
              {% endif %}
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="p-3 border rounded h-100">
            <div class="text-muted small">Date attribution</div>
            <div class="fw-semibold">{{ attribution.dateAttribution|date('d/m/Y H:i') }}</div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="p-3 border rounded h-100">
            <div class="text-muted small">Date retrait</div>
            <div class="fw-semibold">{{ attribution.dateRetrait ? attribution.dateRetrait|date('d/m/Y H:i') : '-' }}</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-md-6">
      <div class="card h-100">
        <div class="card-body">
          <h6 class="text-uppercase text-muted mb-3">Agent</h6>
          <div class="p-3 border rounded">
            <div class="text-muted small">Nom complet</div>
            <div class="fw-semibold">{{ attribution.agent.nomComplet }}</div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card h-100">
        <div class="card-body">
          <h6 class="text-uppercase text-muted mb-3">Point de vente</h6>
          <div class="row g-2">
            <div class="col-md-6">
              <div class="p-3 border rounded">
                <div class="text-muted small">Nom</div>
                <div class="fw-semibold">{{ attribution.pointVente.nomPdv }}</div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="p-3 border rounded">
                <div class="text-muted small">Ville</div>
                <div class="fw-semibold">{{ attribution.pointVente.ville }}</div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="p-3 border rounded">
                <div class="text-muted small">Référence</div>
                <div class="fw-semibold">{{ attribution.pointVente.codeRef }}</div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="p-3 border rounded">
                <div class="text-muted small">Adresse</div>
                <div class="fw-semibold">{{ attribution.pointVente.adresse ?? '-' }}</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
