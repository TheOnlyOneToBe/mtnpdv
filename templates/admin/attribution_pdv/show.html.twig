{% extends 'base.html.twig' %}

{% block title %}Détail attribution PDV{% endblock %}

{% block body %}
<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Détail de l'attribution</h1>
    <div class="d-flex gap-2">
      <a href="{{ path('app_admin_attribution_list') }}" class="btn btn-outline-secondary">Retour à la liste</a>
      <a href="{{ path('app_admin_attribution_edit', {id: attribution.id}) }}" class="btn btn-outline-warning">Modifier</a>
    </div>
  </div>

  <div class="card">
    <div class="card-body">
      <dl class="row">
        <dt class="col-sm-3">ID</dt>
        <dd class="col-sm-9">{{ attribution.id }}</dd>

        <dt class="col-sm-3">Agent</dt>
        <dd class="col-sm-9">{{ attribution.agent.nomComplet }}</dd>

        <dt class="col-sm-3">Point de vente</dt>
        <dd class="col-sm-9">{{ attribution.pointVente.nomPdv }}</dd>

        <dt class="col-sm-3">Ville</dt>
        <dd class="col-sm-9">{{ attribution.pointVente.ville }}</dd>

        <dt class="col-sm-3">Date d'attribution</dt>
        <dd class="col-sm-9">{{ attribution.dateAttribution|date('d/m/Y H:i') }}</dd>

        <dt class="col-sm-3">Date de retrait</dt>
        <dd class="col-sm-9">{{ attribution.dateRetrait ? attribution.dateRetrait|date('d/m/Y H:i') : '-' }}</dd>

        <dt class="col-sm-3">Statut</dt>
        <dd class="col-sm-9">
          {% if attribution.isActif() %}
            <span class="badge bg-success">Active</span>
          {% else %}
            <span class="badge bg-danger">Révoquée</span>
          {% endif %}
        </dd>
      </dl>
    </div>
  </div>
</div>
{% endblock %}
