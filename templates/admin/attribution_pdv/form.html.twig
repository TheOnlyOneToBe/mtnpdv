{% extends 'base.html.twig' %}

{% block title %}Attribution PDV{% endblock %}

{% block body %}
<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">{% if mode == 'create' %}Nouvelle attribution{% else %}Modifier l'attribution{% endif %}</h1>
    <a href="{{ path('app_admin_attribution_list') }}" class="btn btn-outline-secondary">Retour à la liste</a>
  </div>

  {% for message in app.flashes('success') %}
    <div class="alert alert-success">{{ message }}</div>
  {% endfor %}
  {% for message in app.flashes('danger') %}
    <div class="alert alert-danger">{{ message }}</div>
  {% endfor %}

  <div class="card">
    <div class="card-body">
      <form method="post">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Agent</label>
            <select name="agent_id" class="form-select" required>
              <option value="">Sélectionnez un agent</option>
              {% for agent in agents %}
                <option value="{{ agent.id }}" {% if attribution is defined and attribution and attribution.agent.id == agent.id %}selected{% endif %}>{{ agent.nomComplet }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label">Point de vente</label>
            <select name="point_vente_id" class="form-select" required>
              <option value="">Sélectionnez un point de vente</option>
              {% for pointDeVente in pointsDeVente %}
                <option value="{{ pointDeVente.id }}" {% if attribution is defined and attribution and attribution.pointVente.id == pointDeVente.id %}selected{% endif %}>{{ pointDeVente.nomPdv }} ({{ pointDeVente.ville }})</option>
              {% endfor %}
            </select>
          </div>
        </div>

        <div class="mt-4 d-flex justify-content-end gap-2">
          <a href="{{ path('app_admin_attribution_list') }}" class="btn btn-outline-secondary">Annuler</a>
          <button type="submit" class="btn btn-primary">Enregistrer</button>
        </div>
      </form>
    </div>
  </div>
</div>
{% endblock %}
