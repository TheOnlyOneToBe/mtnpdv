{% extends 'base.html.twig' %}

{% block title %}Attribution des PDV{% endblock %}

{% block body %}
<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Attribution des points de vente</h1>
    <a href="{{ path('app_admin_attribution_create') }}" class="btn btn-primary">Nouvelle attribution</a>
  </div>

  {% for message in app.flashes('success') %}
    <div class="alert alert-success">{{ message }}</div>
  {% endfor %}
  {% for message in app.flashes('danger') %}
    <div class="alert alert-danger">{{ message }}</div>
  {% endfor %}

  <div class="card mb-3">
    <div class="card-body">
      <form method="get" action="{{ path('app_admin_attribution_list') }}" class="row g-3">
        <div class="col-md-6">
          <input type="text" name="q" class="form-control" placeholder="Rechercher par agent, PDV, ville..." value="{{ q }}">
        </div>
        <div class="col-md-4">
          <select name="actif" class="form-select">
            <option value="">Tous les statuts</option>
            <option value="1" {% if actifSelectionne === true %}selected{% endif %}>Actives</option>
            <option value="0" {% if actifSelectionne === false %}selected{% endif %}>Révoquées</option>
          </select>
        </div>
        <div class="col-md-2 d-grid">
          <button type="submit" class="btn btn-secondary">Filtrer</button>
        </div>
      </form>
    </div>
  </div>

  {% if attributions|length > 0 %}
 {% set grouped = {} %}
 {% for attribution in attributions %}
 {% set pdvId = attribution.pointVente.id %}
 {% set existing = grouped[pdvId] ?? null %}
 {% if existing is null %}
 {% set grouped = grouped|merge({ (pdvId): { pdv: attribution.pointVente, agents: [attribution] } }) %}
 {% else %}
 {% set grouped = grouped|merge({ (pdvId): { pdv: existing.pdv, agents: existing.agents|merge([attribution]) } }) %}
 {% endif %}
 {% endfor %}
 {% set groupedAttributions = grouped %}

 <div class="table-responsive">
 <table class="table table-hover">
 <thead>
 <tr>
 <th>Point de vente</th>
 <th>Ville</th>
 <th>Agents attribués</th>
 <th class="text-end">Actions</th>
 </tr>
 </thead>
 <tbody>
 {% for pdvId, item in groupedAttributions %}
 <tr>
 <td><strong>{{ item.pdv.nomPdv }}</strong></td>
 <td>{{ item.pdv.ville }}</td>
 <td>
 {% for attribution in item.agents %}
 {{ attribution.agent.nomComplet }}
 <span class="badge {{ attribution.isActif() ? 'bg-success' : 'bg-danger' }}">
 {{ attribution.isActif() ? 'Active' : 'Révoquée' }}
 </span>
 {% if not loop.last %}<br>{% endif %}
 {% else %}
 <span class="text-muted">Aucun agent</span>
 {% endfor %}
 </td>
 <td class="text-end">
 <a href="{{ path('app_admin_attribution_show', {id: item.agents|first.id}) }}" class="btn btn-sm btn-outline-primary">Voir</a>
 <a href="{{ path('app_admin_attribution_edit', {id: item.agents|first.id}) }}" class="btn btn-sm btn-outline-warning">Modifier</a>
 </td>
 </tr>
 {% endfor %}
 </tbody>
 </table>
 </div>
 {% else %}
 <div class="alert alert-warning">Aucune attribution trouvée.</div>
 {% endif %}

  {% if pagination.totalPages > 1 %}
 <nav class="mt-3">
      <ul class="pagination">
        {% for page in 1..pagination.totalPages %}
          <li class="page-item {% if pagination.currentPage %}active{% endif %}">
            <a class="page-link" href="{{ path('app_admin_attribution_list', {page: page, q: q, actif: actifSelectionne is same as(true) ? 1 : (actifSelectionne is same as(false) ? 0 : '')}) }}">{{ page }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  {% endif %}
</div>
{% endblock %}
