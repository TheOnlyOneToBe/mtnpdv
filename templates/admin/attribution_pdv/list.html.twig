{% extends 'base.html.twig' %}

{% block title %}Attribution des PDV{% endblock %}

{% block body %}
<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Attribution des points de vente</h1>
    <a href="{{ path('app_admin_attribution_create') }}" class="btn btn-primary">Nouvelle attribution</a>
  </div>

  {% for message in app.flashes('success') %}
    <div class="alert alert-success">{{ message }}</div>
  {% endfor %}
  {% for message in app.flashes('danger') %}
    <div class="alert alert-danger">{{ message }}</div>
  {% endfor %}

  <div class="card mb-3">
    <div class="card-body">
      <form method="get" action="{{ path('app_admin_attribution_list') }}" class="row g-3">
        <div class="col-md-6">
          <input type="text" name="q" class="form-control" placeholder="Rechercher par agent, PDV, ville..." value="{{ q }}">
        </div>
        <div class="col-md-4">
          <select name="actif" class="form-select">
            <option value="">Tous les statuts</option>
            <option value="1" {% if actifSelectionne === true %}selected{% endif %}>Actives</option>
            <option value="0" {% if actifSelectionne === false %}selected{% endif %}>Révoquées</option>
          </select>
        </div>
        <div class="col-md-2 d-grid">
          <button type="submit" class="btn btn-secondary">Filtrer</button>
        </div>
      </form>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-hover">
      <thead>
        <tr>
          <th>ID</th>
          <th>Agent</th>
          <th>Point de vente</th>
          <th>Ville</th>
          <th>Date attribution</th>
          <th>Date retrait</th>
          <th>Statut</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for attribution in attributions %}
          <tr>
            <td>{{ attribution.id }}</td>
            <td>{{ attribution.agent.nomComplet }}</td>
            <td>{{ attribution.pointVente.nomPdv }}</td>
            <td>{{ attribution.pointVente.ville }}</td>
            <td>{{ attribution.dateAttribution|date('d/m/Y H:i') }}</td>
            <td>{{ attribution.dateRetrait ? attribution.dateRetrait|date('d/m/Y H:i') : '-' }}</td>
            <td>
              {% if attribution.isActif() %}
                <span class="badge bg-success">Active</span>
              {% else %}
                <span class="badge bg-danger">Révoquée</span>
              {% endif %}
            </td>
            <td class="text-end">
              <a href="{{ path('app_admin_attribution_show', {id: attribution.id}) }}" class="btn btn-sm btn-outline-primary">Voir</a>
              <a href="{{ path('app_admin_attribution_edit', {id: attribution.id}) }}" class="btn btn-sm btn-outline-warning">Modifier</a>
              {% if attribution.isActif() %}
                <form method="post" action="{{ path('app_admin_attribution_revoke', {id: attribution.id}) }}" class="d-inline" onsubmit="return confirm('Révoquer cette attribution ?');">
                  <input type="hidden" name="_token" value="{{ csrf_token('revoke-attribution-' ~ attribution.id) }}">
                  <button type="submit" class="btn btn-sm btn-outline-danger">Révoquer</button>
                </form>
              {% else %}
                <form method="post" action="{{ path('app_admin_attribution_restore', {id: attribution.id}) }}" class="d-inline" onsubmit="return confirm('Rétablir cette attribution ?');">
                  <input type="hidden" name="_token" value="{{ csrf_token('restore-attribution-' ~ attribution.id) }}">
                  <button type="submit" class="btn btn-sm btn-outline-success">Rétablir</button>
                </form>
              {% endif %}
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="8" class="text-center text-muted">Aucune attribution trouvée.</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  {% if pagination.pageCount > 1 %}
    <nav class="mt-3">
      <ul class="pagination">
        {% for page in 1..pagination.pageCount %}
          <li class="page-item {% if page == pagination.current %}active{% endif %}">
            <a class="page-link" href="{{ path('app_admin_attribution_list', {page: page, q: q, actif: actifSelectionne is same as(true) ? 1 : (actifSelectionne is same as(false) ? 0 : '')}) }}">{{ page }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  {% endif %}
</div>
{% endblock %}
