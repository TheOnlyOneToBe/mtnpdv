{% extends 'base.html.twig' %}

{% block title %}Dashboard Admin - MTNPDV{% endblock %}

{% block body %}
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="mb-2">Dashboard Admin</h1>
            <p class="text-muted">Bienvenue {{ app.user.prenomUt }} {{ app.user.nomUt }}</p>
        </div>
    </div>

    <!-- Statistiques -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-0">Visites en attente</p>
                            <h3 class="mb-0 mt-2">{{ nbVisitesEnAttente }}</h3>
                        </div>
                        <div style="font-size: 2rem; opacity: 0.3;"><i class="fas fa-hourglass-end"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-0">Points de vente</p>
                            <h3 class="mb-0 mt-2">-</h3>
                        </div>
                        <div style="font-size: 2rem; opacity: 0.3;"><i class="fas fa-store"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-0">Utilisateurs</p>
                            <h3 class="mb-0 mt-2">-</h3>
                        </div>
                        <div style="font-size: 2rem; opacity: 0.3;"><i class="fas fa-users"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-0">Chiffre d'affaires</p>
                            <h3 class="mb-0 mt-2">-</h3>
                        </div>
                        <div style="font-size: 2rem; opacity: 0.3;"><i class="fas fa-money-bill"></i></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Visites à valider -->
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Visites à valider</h5>
                </div>
                <div class="card-body">
                    {% if visitesEnAttente|length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Agent</th>
                                        <th>Point de vente</th>
                                        <th>Type</th>
                                        <th>Montant</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for visite in visitesEnAttente %}
                                        <tr>
                                            <td>{{ visite.dateTransac|date('d/m/Y H:i') }}</td>
                                            <td>{{ visite.utilisateur.prenomUt }} {{ visite.utilisateur.nomUt }}</td>
                                            <td>{{ visite.pointVente.nom }}</td>
                                            <td>
                                                <span class="badge bg-info">{{ visite.type.value }}</span>
                                            </td>
                                            <td>{{ visite.montant.toDecimal() }} €</td>
                                            <td>
                                                <button class="btn btn-sm btn-success">Valider</button>
                                                <button class="btn btn-sm btn-danger">Rejeter</button>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="alert alert-info mb-0">
                            ✓ Aucune visite en attente de validation
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Actions rapides -->
    <div class="row mt-4">
        <div class="col-md-12">
            <h5>Actions rapides</h5>
            <div class="btn-group" role="group">
                <a href="#" class="btn btn-outline-primary">Gérer les PDV</a>
                <a href="#" class="btn btn-outline-primary">Gérer les utilisateurs</a>
                <a href="#" class="btn btn-outline-primary">Gérer les produits</a>
                <a href="#" class="btn btn-outline-primary">Voir la carte</a>
            </div>
        </div>
    </div>
{% endblock %}
