{% extends 'base.html.twig' %}

{% block title %}Rôles - {{ app_name }}{% endblock %}

{% block body %}
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="mb-2"><i class="fas fa-lock"></i> Rôles et permissions</h1>
            <p class="text-muted">Gérez les rôles du système</p>
        </div>
    </div>

    {% if roles|length > 0 %}
        <div class="mb-3">
            <small class="text-muted">
                Affichage {{ itemRange.start }}-{{ itemRange.end }} sur {{ pagination.totalItems }} rôles
            </small>
        </div>
        <div class="row">
            {% for role in roles %}
                <div class="col-md-6 mb-4">
                    <div class="card h-100">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="fas fa-shield"></i> {{ role.codeRole }}
                            </h5>
                        </div>
                        <div class="card-body">
                            <p class="mb-3">
                                <strong>Libellé:</strong> {{ role.libelle }}
                            </p>
                            <p class="mb-0">
                                <strong>Utilisateurs assignés:</strong>
                                <span class="badge bg-secondary">{{ role.utilisateurs|length }}</span>
                            </p>
                        </div>
                        <div class="card-footer bg-light">
                            <a href="{{ path('app_admin_role_show', {id: role.id}) }}" class="btn btn-sm btn-info">
                                <i class="fas fa-eye"></i> Détails
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        {% if pagination.totalPages > 1 %}
            <nav aria-label="Pagination" class="mt-4">
                <ul class="pagination justify-content-center">
                    {% if pagination.hasPreviousPage %}
                        <li class="page-item">
                            <a class="page-link" href="{{ path('app_admin_role_list', {page: 1}) }}">
                                <i class="fas fa-step-backward"></i> Début
                            </a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="{{ path('app_admin_role_list', {page: pagination.currentPage - 1}) }}">
                                <i class="fas fa-chevron-left"></i> Précédent
                            </a>
                        </li>
                    {% else %}
                        <li class="page-item disabled">
                            <span class="page-link"><i class="fas fa-step-backward"></i> Début</span>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link"><i class="fas fa-chevron-left"></i> Précédent</span>
                        </li>
                    {% endif %}

                    {% for page in pageMetadata.pages %}
                        {% if page is none %}
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        {% elseif page == pagination.currentPage %}
                            <li class="page-item active">
                                <span class="page-link">{{ page }}</span>
                            </li>
                        {% else %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path('app_admin_role_list', {page: page}) }}">{{ page }}</a>
                            </li>
                        {% endif %}
                    {% endfor %}

                    {% if pagination.hasNextPage %}
                        <li class="page-item">
                            <a class="page-link" href="{{ path('app_admin_role_list', {page: pagination.currentPage + 1}) }}">
                                Suivant <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="{{ path('app_admin_role_list', {page: pagination.totalPages}) }}">
                                Fin <i class="fas fa-step-forward"></i>
                            </a>
                        </li>
                    {% else %}
                        <li class="page-item disabled">
                            <span class="page-link">Suivant <i class="fas fa-chevron-right"></i></span>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link">Fin <i class="fas fa-step-forward"></i></span>
                        </li>
                    {% endif %}
                </ul>
            </nav>
        {% endif %}
    {% else %}
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> Aucun rôle disponible.
        </div>
    {% endif %}
{% endblock %}
