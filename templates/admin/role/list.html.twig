{% extends 'base.html.twig' %}

{% block title %}Rôles - MTNPDV{% endblock %}

{% block body %}
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="mb-2"><i class="fas fa-lock"></i> Rôles et permissions</h1>
            <p class="text-muted">Gérez les rôles du système</p>
        </div>
    </div>

    {% if roles|length > 0 %}
        <div class="row">
            {% for role in roles %}
                <div class="col-md-6 mb-4">
                    <div class="card h-100">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="fas fa-shield"></i> {{ role.codeRole }}
                            </h5>
                        </div>
                        <div class="card-body">
                            <p class="mb-3">
                                <strong>Libellé:</strong> {{ role.libelleRole }}
                            </p>
                            <p class="mb-3">
                                <strong>Description:</strong>
                                {% if role.descriptionRole %}
                                    {{ role.descriptionRole }}
                                {% else %}
                                    <em class="text-muted">Aucune description</em>
                                {% endif %}
                            </p>
                            <p class="mb-0">
                                <strong>Utilisateurs assignés:</strong>
                                {{ role.utilisateurs|length }}
                            </p>
                        </div>
                        <div class="card-footer bg-light">
                            <a href="{{ path('app_admin_role_show', {id: role.id}) }}" class="btn btn-sm btn-info">
                                <i class="fas fa-eye"></i> Détails
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> Aucun rôle disponible.
        </div>
    {% endif %}
{% endblock %}
