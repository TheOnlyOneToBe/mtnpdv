{% extends 'base.html.twig' %}

{% block title %}Modifier {{ role.codeRole }} - {{ app_name }}{% endblock %}

{% block body %}
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="mb-2"><i class="fas fa-shield"></i> Modifier le rôle</h1>
            <p class="text-muted">Éditer les informations du rôle</p>
        </div>
        <div class="col-md-4 text-end">
            <a href="{{ path('app_admin_role_show', {id: role.id}) }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Retour
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="fas fa-edit"></i> Formulaire d'édition</h5>
                </div>
                <div class="card-body">
                    <form method="POST" novalidate>
                        <div class="mb-3">
                            <label for="codeRole" class="form-label">Code du rôle</label>
                            <input
                                type="text"
                                class="form-control"
                                id="codeRole"
                                name="codeRole"
                                value="{{ role.codeRole }}"
                                required>
                            <small class="text-muted">Format: ADMIN, AGENT, GERANT, etc.</small>
                        </div>

                        <div class="mb-3">
                            <label for="libelle" class="form-label">Libellé</label>
                            <input
                                type="text"
                                class="form-control"
                                id="libelle"
                                name="libelle"
                                value="{{ role.libelle }}"
                                required>
                            <small class="text-muted">Nom lisible du rôle</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Utilisateurs assignés</label>
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle"></i>
                                <strong>{{ role.utilisateurs|length }}</strong> utilisateur(s) ont ce rôle.
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Enregistrer les modifications
                            </button>
                            <a href="{{ path('app_admin_role_show', {id: role.id}) }}" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Annuler
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="fas fa-exclamation-triangle"></i> Zone de danger</h5>
                </div>
                <div class="card-body">
                    <p class="mb-3">Supprimer ce rôle est une action irréversible.</p>
                    {% if role.utilisateurs|length > 0 %}
                        <div class="alert alert-warning mb-3">
                            <i class="fas fa-warning"></i> Ce rôle est assigné à {{ role.utilisateurs|length }} utilisateur(s). Assurez-vous de le réassigner avant de supprimer.
                        </div>
                    {% endif %}
                    <form method="POST" action="{{ path('app_admin_role_delete', {id: role.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce rôle ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-role-' ~ role.id) }}">
                        <button type="submit" class="btn btn-danger w-100">
                            <i class="fas fa-trash"></i> Supprimer le rôle
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
