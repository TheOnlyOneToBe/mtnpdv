<turbo-stream action="remove" target="visite-{{ transaction.id }}">
  <template></template>
</turbo-stream>

<turbo-stream action="update" target="validation-alert">
  <template>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="fas fa-check-circle"></i>
      <strong>Succès!</strong> Visite validée avec succès.
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  </template>
</turbo-stream>
