{% extends 'base.html.twig' %}

{% block title %}Suivi des agents - {{ app_name }}{% endblock %}

{% block body %}
    <div class="container-lg py-4">
        <div class="row mb-4">
            <div class="col-md-8">
                <h1 class="mb-2"><i class="fas fa-users-viewfinder"></i> Suivi des agents</h1>
                <p class="text-muted">Consultez l’activité des agents et la confirmation GPS de leurs déplacements.</p>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="fas fa-filter"></i> Filtres</h5>
            </div>
            <div class="card-body">
                <form method="get" class="row g-3">
                    <div class="col-md-4">
                        <label for="agent" class="form-label">Agent</label>
                        <select id="agent" name="agent" class="form-select">
                            <option value="">Tous les agents</option>
                            {% for agent in agents %}
                                <option value="{{ agent.id }}" {% if filtre.agent|default('') == agent.id %}selected{% endif %}>{{ agent.nomComplet }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="debut" class="form-label">Date début</label>
                        <input id="debut" name="debut" type="date" class="form-control" value="{{ filtre.debut|default('') }}">
                    </div>
                    <div class="col-md-3">
                        <label for="fin" class="form-label">Date fin</label>
                        <input id="fin" name="fin" type="date" class="form-control" value="{{ filtre.fin|default('') }}">
                    </div>
                    <div class="col-md-2 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary">Filtrer</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="fas fa-chart-column"></i> Activité des agents</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Agent</th>
                            <th>Total visites</th>
                            <th>Validées</th>
                            <th>En attente</th>
                            <th>Dernière visite</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for ligne in activite %}
                            <tr>
                                <td><strong>{{ ligne.agent.nomComplet }}</strong></td>
                                <td>{{ ligne.totalVisites }}</td>
                                <td><span class="badge bg-success">{{ ligne.visitesValidees }}</span></td>
                                <td><span class="badge bg-warning">{{ ligne.visitesEnAttente }}</span></td>
                                <td>{{ ligne.derniereVisite ? ligne.derniereVisite|date('d/m/Y H:i') : 'Aucune' }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">Aucune activité agent disponible.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {% if agentSelectionne %}
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="fas fa-route"></i> Historique des interventions de {{ agentSelectionne.nomComplet }}</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Point de vente</th>
                                <th>Distance GPS</th>
                                <th>Confirmation</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for visite in historique %}
                                <tr>
                                    <td>{{ visite.transaction.dateTransac|date('d/m/Y H:i') }}</td>
                                    <td>{{ visite.transaction.pointVente ? visite.transaction.pointVente.nomPdv : 'N/A' }}</td>
                                    <td>{{ visite.distanceMetres }} m</td>
                                    <td>
                                        {% if visite.gpsConfirme %}
                                            <span class="badge bg-success">Confirmé</span>
                                        {% else %}
                                            <span class="badge bg-danger">Non confirmé</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ visite.transaction.statut.value }}</td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">Aucune intervention trouvée pour cet agent.</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
