{% extends 'base.html.twig' %}

{% block title %}Transactions supervisées - {{ app_name }}{% endblock %}

{% block body %}
    <div class="container-lg py-4">
        <div class="row mb-4">
            <div class="col-md-8">
                <h1 class="mb-2"><i class="fas fa-money-check-dollar"></i> Transactions supervisées</h1>
                <p class="text-muted">Filtrez les distributions de cash, approvisionnements de flotte et visites.</p>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="fas fa-filter"></i> Filtres</h5>
            </div>
            <div class="card-body">
                <form method="get" class="row g-3">
                    <div class="col-md-3">
                        <label for="type" class="form-label">Type</label>
                        <select id="type" name="type" class="form-select">
                            <option value="">Tous</option>
                            {% for type in typesSupervision %}
                                <option value="{{ type.value }}" {% if filtre.type|default('') == type.value %}selected{% endif %}>{{ type.libelle() }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="pdv" class="form-label">Point de vente</label>
                        <select id="pdv" name="pdv" class="form-select">
                            <option value="">Tous</option>
                            {% for pdv in pointVentes %}
                                <option value="{{ pdv.id }}" {% if filtre.pdv|default('') == pdv.id %}selected{% endif %}>{{ pdv.nomPdv }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="agent" class="form-label">Agent</label>
                        <select id="agent" name="agent" class="form-select">
                            <option value="">Tous</option>
                            {% for agent in agents %}
                                <option value="{{ agent.id }}" {% if filtre.agent|default('') == agent.id %}selected{% endif %}>{{ agent.nomComplet }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="debut" class="form-label">Date début</label>
                        <input id="debut" name="debut" type="date" class="form-control" value="{{ filtre.debut|default('') }}">
                    </div>
                    <div class="col-md-3">
                        <label for="fin" class="form-label">Date fin</label>
                        <input id="fin" name="fin" type="date" class="form-control" value="{{ filtre.fin|default('') }}">
                    </div>
                    <div class="col-md-3">
                        <label for="montant_min" class="form-label">Montant min</label>
                        <input id="montant_min" name="montant_min" type="number" step="0.01" class="form-control" value="{{ filtre.montant_min|default('') }}">
                    </div>
                    <div class="col-md-3">
                        <label for="montant_max" class="form-label">Montant max</label>
                        <input id="montant_max" name="montant_max" type="number" step="0.01" class="form-control" value="{{ filtre.montant_max|default('') }}">
                    </div>
                    <div class="col-md-3 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary">Filtrer</button>
                        <a href="{{ path('app_admin_supervision_transactions') }}" class="btn btn-secondary">Réinitialiser</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-table"></i> Résultats</h5>
                <div>
                    <span class="badge bg-primary me-2">{{ pagination.totalItems }} transaction(s)</span>
                    {% if pagination.totalItems > 0 %}
                        <span class="text-muted small">
                            Affichage {{ itemRange.start }} - {{ itemRange.end }} sur {{ pagination.totalItems }}
                            (page {{ pagination.currentPage }} / {{ pagination.totalPages }})
                        </span>
                    {% endif %}
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Point de vente</th>
                            <th>Agent</th>
                            <th>Montant</th>
                            <th>Statut</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for transaction in transactions %}
                            <tr>
                                <td>{{ transaction.dateTransac|date('d/m/Y H:i') }}</td>
                                <td>{{ transaction.type.libelle() }}</td>
                                <td>{{ transaction.pointVente ? transaction.pointVente.nomPdv : 'N/A' }}</td>
                                <td>{{ transaction.agent ? transaction.agent.nomComplet : 'N/A' }}</td>
                                <td>{{ transaction.montant }}</td>
                                <td>
                                    {% set statut = transaction.statut.value %}
                                    <span class="badge bg-{% if statut == 'VALIDEE' %}success{% elseif statut == 'EN_ATTENTE' %}warning{% elseif statut == 'REJETEE' %}danger{% else %}secondary{% endif %}">
                                        {{ statut }}
                                    </span>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">Aucune transaction ne correspond aux filtres sélectionnés.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% if pagination.totalPages > 1 %}
                <div class="card-footer bg-light">
                    <nav aria-label="Pagination des transactions">
                        <ul class="pagination justify-content-center mb-0">
                            {# Bouton précédent #}
                            <li class="page-item {% if not pagination.hasPreviousPage %}disabled{% endif %}">
                                <a class="page-link" href="{{ path('app_admin_supervision_transactions', filtre|merge({page: pagination.currentPage - 1, limite: pagination.limit})) }}" aria-label="Précédent">
                                    <span aria-hidden="true">&laquo;</span>
                                </a>
                            </li>

                            {# Numéros de pages #}
                            {% for numero in pageMetadata.pages %}
                                {% if numero is null %}
                                    <li class="page-item disabled"><span class="page-link">…</span></li>
                                {% else %}
                                    <li class="page-item {% if numero == pagination.currentPage %}active{% endif %}">
                                        <a class="page-link" href="{{ path('app_admin_supervision_transactions', filtre|merge({page: numero, limite: pagination.limit})) }}">{{ numero }}</a>
                                    </li>
                                {% endif %}
                            {% endfor %}

                            {# Bouton suivant #}
                            <li class="page-item {% if not pagination.hasNextPage %}disabled{% endif %}">
                                <a class="page-link" href="{{ path('app_admin_supervision_transactions', filtre|merge({page: pagination.currentPage + 1, limite: pagination.limit})) }}" aria-label="Suivant">
                                    <span aria-hidden="true">&raquo;</span>
                                </a>
                            </li>
                        </ul>
                    </nav>

                    <form method="get" class="d-flex justify-content-center align-items-center gap-2 mt-3">
                        {% for cle, valeur in filtre %}
                            {% if cle != 'page' and cle != 'limite' %}
                                <input type="hidden" name="{{ cle }}" value="{{ valeur }}">
                            {% endif %}
                        {% endfor %}
                        <label for="limite" class="form-label mb-0 small text-muted">Par page :</label>
                        <select id="limite" name="limite" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
                            {% for n in [12, 25, 50, 100] %}
                                <option value="{{ n }}" {% if pagination.limit == n %}selected{% endif %}>{{ n }}</option>
                            {% endfor %}
                        </select>
                    </form>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
