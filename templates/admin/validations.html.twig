{% extends 'base.html.twig' %}

{% block title %}Validations des visites - {{ app_name }}{% endblock %}

{% block body %}
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="mb-2"><i class="fas fa-check-circle"></i> Validations des visites</h1>
            <p class="text-muted">Validez ou rejetez les visites en attente</p>
        </div>
    </div>

    <!-- Alert container for notifications -->
    <div id="validation-alert"></div>

    <!-- Statistiques -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-0">En attente</p>
                            <h3 class="mb-0 mt-2">{{ nbEnAttente }}</h3>
                        </div>
                        <div style="font-size: 2rem; opacity: 0.3;"><i class="fas fa-hourglass-end"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-0">Validées</p>
                            <h3 class="mb-0 mt-2 text-success">{{ nbValidees }}</h3>
                        </div>
                        <div style="font-size: 2rem; opacity: 0.3;"><i class="fas fa-check"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-0">Rejetées</p>
                            <h3 class="mb-0 mt-2 text-danger">{{ nbRejetees }}</h3>
                        </div>
                        <div style="font-size: 2rem; opacity: 0.3;"><i class="fas fa-times"></i></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Visites en attente -->
    <div class="row">
        <div class="col-md-12">
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="fas fa-hourglass-end"></i> Visites en attente de validation</h5>
                </div>
                <div class="card-body">
                    {% if visitesEnAttente|length > 0 %}
                        <div class="mb-3">
                            <small class="text-muted">
                                Affichage {{ paginationEnAttente.offset + 1 }}-{{ paginationEnAttente.offset + visitesEnAttente|length }} sur {{ paginationEnAttente.totalItems }} visites
                            </small>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Agent</th>
                                        <th>Point de vente</th>
                                        <th>Type</th>
                                        <th>Montant</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for visite in visitesEnAttente %}
                                        <tr id="visite-{{ visite.id }}">
                                            <td>{{ visite.dateTransac|date('d/m/Y H:i') }}</td>
                                            <td>{{ visite.utilisateur.prenomUt }} {{ visite.utilisateur.nomUt }}</td>
                                            <td>{{ visite.pointVente.nomPdv }}</td>
                                            <td>
                                                <span class="badge bg-info">{{ visite.typeTransaction.value }}</span>
                                            </td>
                                            <td>{% if visite.montant %}{{ visite.montant.montantCentimes / 100 }}€{% else %}-{% endif %}</td>
                                            <td>
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <form method="POST" action="{{ path('app_admin_validation_approve', {id: visite.id}) }}" style="display: inline;" class="validation-form">
                                                        <button type="submit" class="btn btn-sm btn-success" title="Valider cette visite">
                                                            <i class="fas fa-check"></i> Valider
                                                        </button>
                                                    </form>
                                                    <button type="button" class="btn btn-sm btn-danger" title="Rejeter cette visite" data-bs-toggle="modal" data-bs-target="#rejectModal" data-visite-id="{{ visite.id }}" data-visite-pdv="{{ visite.pointVente.nomPdv }}">
                                                        <i class="fas fa-times"></i> Rejeter
                                                    </button>
                                                    <a href="{{ path('app_agent_visite_show', {id: visite.id}) }}" class="btn btn-sm btn-info" title="Voir les détails">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>

                        {% if paginationEnAttente.totalPages > 1 %}
                            <nav aria-label="Pagination en attente" class="mt-3">
                                <ul class="pagination pagination-sm justify-content-center mb-0">
                                    {% if paginationEnAttente.hasPreviousPage %}
                                        <li class="page-item">
                                            <a class="page-link" href="{{ path('app_admin_validations', {tab: 'en_attente', page: paginationEnAttente.currentPage - 1}) }}">
                                                Précédent
                                            </a>
                                        </li>
                                    {% else %}
                                        <li class="page-item disabled">
                                            <span class="page-link">Précédent</span>
                                        </li>
                                    {% endif %}

                                    {% for page in paginationEnAttente.currentPage %}
                                        <li class="page-item active">
                                            <span class="page-link">Page {{ paginationEnAttente.currentPage }}/{{ paginationEnAttente.totalPages }}</span>
                                        </li>
                                    {% endfor %}

                                    {% if paginationEnAttente.hasNextPage %}
                                        <li class="page-item">
                                            <a class="page-link" href="{{ path('app_admin_validations', {tab: 'en_attente', page: paginationEnAttente.currentPage + 1}) }}">
                                                Suivant
                                            </a>
                                        </li>
                                    {% else %}
                                        <li class="page-item disabled">
                                            <span class="page-link">Suivant</span>
                                        </li>
                                    {% endif %}
                                </ul>
                            </nav>
                        {% endif %}
                    {% else %}
                        <div class="alert alert-success mb-0">
                            <i class="fas fa-check-circle"></i> Aucune visite en attente de validation
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Onglets pour l'historique -->
    <div class="row">
        <div class="col-md-12">
            <ul class="nav nav-tabs mb-3" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link {% if activeTab == 'validees' %}active{% endif %}" id="validees-tab" data-bs-toggle="tab" data-bs-target="#validees" type="button" role="tab">
                        <i class="fas fa-check"></i> Visites validées ({{ nbValidees }})
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link {% if activeTab == 'rejetees' %}active{% endif %}" id="rejetees-tab" data-bs-toggle="tab" data-bs-target="#rejetees" type="button" role="tab">
                        <i class="fas fa-times"></i> Visites rejetées ({{ nbRejetees }})
                    </button>
                </li>
            </ul>

            <div class="tab-content">
                <!-- Visites validées -->
                <div class="tab-pane fade {% if activeTab == 'validees' %}show active{% endif %}" id="validees" role="tabpanel">
                    <div class="card">
                        <div class="card-body">
                            {% if visitesValidees|length > 0 %}
                                <div class="mb-3">
                                    <small class="text-muted">
                                        Affichage {{ paginationValidees.offset + 1 }}-{{ paginationValidees.offset + visitesValidees|length }} sur {{ paginationValidees.totalItems }} visites
                                    </small>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-hover table-sm mb-0">
                                        <thead>
                                            <tr>
                                                <th>Date</th>
                                                <th>Agent</th>
                                                <th>Point de vente</th>
                                                <th>Type</th>
                                                <th>Montant</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for visite in visitesValidees %}
                                                <tr>
                                                    <td>{{ visite.dateTransac|date('d/m/Y H:i') }}</td>
                                                    <td>{{ visite.utilisateur.prenomUt }} {{ visite.utilisateur.nomUt }}</td>
                                                    <td>{{ visite.pointVente.nomPdv }}</td>
                                                    <td>
                                                        <span class="badge bg-info">{{ visite.typeTransaction.value }}</span>
                                                    </td>
                                                    <td>{% if visite.montant %}{{ visite.montant.toDecimal() }} €{% else %}-{% endif %}</td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>

                                {% if paginationValidees.totalPages > 1 %}
                                    <nav aria-label="Pagination validées" class="mt-3">
                                        <ul class="pagination pagination-sm justify-content-center mb-0">
                                            {% if paginationValidees.hasPreviousPage %}
                                                <li class="page-item">
                                                    <a class="page-link" href="{{ path('app_admin_validations', {tab: 'validees', page: paginationValidees.currentPage - 1}) }}">
                                                        Précédent
                                                    </a>
                                                </li>
                                            {% else %}
                                                <li class="page-item disabled">
                                                    <span class="page-link">Précédent</span>
                                                </li>
                                            {% endif %}

                                            <li class="page-item active">
                                                <span class="page-link">Page {{ paginationValidees.currentPage }}/{{ paginationValidees.totalPages }}</span>
                                            </li>

                                            {% if paginationValidees.hasNextPage %}
                                                <li class="page-item">
                                                    <a class="page-link" href="{{ path('app_admin_validations', {tab: 'validees', page: paginationValidees.currentPage + 1}) }}">
                                                        Suivant
                                                    </a>
                                                </li>
                                            {% else %}
                                                <li class="page-item disabled">
                                                    <span class="page-link">Suivant</span>
                                                </li>
                                            {% endif %}
                                        </ul>
                                    </nav>
                                {% endif %}
                            {% else %}
                                <div class="alert alert-info mb-0">
                                    <i class="fas fa-info-circle"></i> Aucune visite validée
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <!-- Visites rejetées -->
                <div class="tab-pane fade {% if activeTab == 'rejetees' %}show active{% endif %}" id="rejetees" role="tabpanel">
                    <div class="card">
                        <div class="card-body">
                            {% if visitesRejetees|length > 0 %}
                                <div class="mb-3">
                                    <small class="text-muted">
                                        Affichage {{ paginationRejetees.offset + 1 }}-{{ paginationRejetees.offset + visitesRejetees|length }} sur {{ paginationRejetees.totalItems }} visites
                                    </small>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-hover table-sm mb-0">
                                        <thead>
                                            <tr>
                                                <th>Date</th>
                                                <th>Agent</th>
                                                <th>Point de vente</th>
                                                <th>Type</th>
                                                <th>Montant</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for visite in visitesRejetees %}
                                                <tr>
                                                    <td>{{ visite.dateTransac|date('d/m/Y H:i') }}</td>
                                                    <td>{{ visite.utilisateur.prenomUt }} {{ visite.utilisateur.nomUt }}</td>
                                                    <td>{{ visite.pointVente.nomPdv }}</td>
                                                    <td>
                                                        <span class="badge bg-info">{{ visite.typeTransaction.value }}</span>
                                                    </td>
                                                    <td>{% if visite.montant %}{{ visite.montant.toDecimal() }} €{% else %}-{% endif %}</td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>

                                {% if paginationRejetees.totalPages > 1 %}
                                    <nav aria-label="Pagination rejetées" class="mt-3">
                                        <ul class="pagination pagination-sm justify-content-center mb-0">
                                            {% if paginationRejetees.hasPreviousPage %}
                                                <li class="page-item">
                                                    <a class="page-link" href="{{ path('app_admin_validations', {tab: 'rejetees', page: paginationRejetees.currentPage - 1}) }}">
                                                        Précédent
                                                    </a>
                                                </li>
                                            {% else %}
                                                <li class="page-item disabled">
                                                    <span class="page-link">Précédent</span>
                                                </li>
                                            {% endif %}

                                            <li class="page-item active">
                                                <span class="page-link">Page {{ paginationRejetees.currentPage }}/{{ paginationRejetees.totalPages }}</span>
                                            </li>

                                            {% if paginationRejetees.hasNextPage %}
                                                <li class="page-item">
                                                    <a class="page-link" href="{{ path('app_admin_validations', {tab: 'rejetees', page: paginationRejetees.currentPage + 1}) }}">
                                                        Suivant
                                                    </a>
                                                </li>
                                            {% else %}
                                                <li class="page-item disabled">
                                                    <span class="page-link">Suivant</span>
                                                </li>
                                            {% endif %}
                                        </ul>
                                    </nav>
                                {% endif %}
                            {% else %}
                                <div class="alert alert-info mb-0">
                                    <i class="fas fa-info-circle"></i> Aucune visite rejetée
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de rejet -->
    <div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="rejectModalLabel">
                        <i class="fas fa-times-circle text-danger"></i> Rejeter la visite
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="POST" id="rejectForm">
                    <div class="modal-body">
                        <div class="alert alert-warning mb-3">
                            <i class="fas fa-exclamation-triangle"></i>
                            <strong>Confirmation du rejet</strong><br>
                            Vous êtes sur le point de rejeter la visite du <strong id="visitePdv"></strong>.
                        </div>
                        <div class="mb-3">
                            <label for="rejectionReason" class="form-label">Raison du rejet (optionnel)</label>
                            <textarea class="form-control" id="rejectionReason" name="reason" rows="3" placeholder="Explicitez pourquoi cette visite est rejetée..."></textarea>
                            <small class="form-text text-muted">Cette information sera visible par l'agent.</small>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-times"></i> Confirmer le rejet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        // Handle reject modal
        const rejectModal = document.getElementById('rejectModal');
        if (rejectModal) {
            rejectModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const visiteId = button.getAttribute('data-visite-id');
                const visitePdv = button.getAttribute('data-visite-pdv');
                const form = document.getElementById('rejectForm');

                document.getElementById('visitePdv').textContent = visitePdv;
                form.action = '{{ path("app_admin_validation_reject", {id: "PLACEHOLDER"}) }}'.replace('PLACEHOLDER', visiteId);
            });
        }
    </script>
{% endblock %}
