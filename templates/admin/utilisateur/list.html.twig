{% extends 'base.html.twig' %}

{% block title %}Utilisateurs - {{ app_name }}{% endblock %}

{% block body %}
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="mb-2"><i class="fas fa-users"></i> Utilisateurs</h1>
            <p class="text-muted">Gérez les utilisateurs du système</p>
        </div>
        <div class="col-md-4 text-end">
            <a href="{{ path('app_admin_utilisateur_create') }}" class="btn btn-primary">
                <i class="fas fa-plus"></i> Nouvel utilisateur
            </a>
        </div>
    </div>

    {% if utilisateurs|length > 0 %}
        <div class="mb-3">
            <small class="text-muted">
                Affichage {{ itemRange.start }}-{{ itemRange.end }} sur {{ pagination.totalItems }} utilisateurs
            </small>
        </div>
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Email</th>
                            <th>Nom</th>
                            <th>Téléphone</th>
                            <th>Statut</th>
                            <th>Rôles</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for utilisateur in utilisateurs %}
                            <tr>
                                <td>
                                    <strong>{{ utilisateur.email.toString() }}</strong>
                                </td>
                                <td>{{ utilisateur.prenomUt }} {{ utilisateur.nomUt }}</td>
                                <td>{{ utilisateur.telephone.toString() }}</td>
                                <td>
                                    <span class="badge bg-{% if utilisateur.statutUtilisateur.value == 'ACTIF' %}success{% elseif utilisateur.statutUtilisateur.value == 'INACTIF' %}danger{% else %}warning{% endif %}">
                                        {{ utilisateur.statutUtilisateur.value }}
                                    </span>
                                </td>
                                <td>
                                    {% for role in utilisateur.rolesEntites %}
                                        <span class="badge bg-info">{{ role.codeRole }}</span>
                                    {% endfor %}
                                </td>
                                <td>
                                    <a href="{{ path('app_admin_utilisateur_show', {id: utilisateur.id}) }}" class="btn btn-sm btn-info">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="{{ path('app_admin_utilisateur_edit', {id: utilisateur.id}) }}" class="btn btn-sm btn-warning">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form method="POST" action="{{ path('app_admin_utilisateur_delete', {id: utilisateur.id}) }}" style="display: inline;" data-turbo="false">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-user-' ~ utilisateur.id) }}">
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Supprimer cet utilisateur ?');">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {% if pagination.totalPages > 1 %}
            <nav aria-label="Pagination" class="mt-4">
                <ul class="pagination justify-content-center">
                    {% if pagination.hasPreviousPage %}
                        <li class="page-item">
                            <a class="page-link" href="{{ path('app_admin_utilisateur_list', {page: 1}) }}">
                                <i class="fas fa-step-backward"></i> Début
                            </a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="{{ path('app_admin_utilisateur_list', {page: pagination.currentPage - 1}) }}">
                                <i class="fas fa-chevron-left"></i> Précédent
                            </a>
                        </li>
                    {% else %}
                        <li class="page-item disabled">
                            <span class="page-link"><i class="fas fa-step-backward"></i> Début</span>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link"><i class="fas fa-chevron-left"></i> Précédent</span>
                        </li>
                    {% endif %}

                    {% for page in pageMetadata.pages %}
                        {% if page is none %}
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        {% elseif page == pagination.currentPage %}
                            <li class="page-item active">
                                <span class="page-link">{{ page }}</span>
                            </li>
                        {% else %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path('app_admin_utilisateur_list', {page: page}) }}">{{ page }}</a>
                            </li>
                        {% endif %}
                    {% endfor %}

                    {% if pagination.hasNextPage %}
                        <li class="page-item">
                            <a class="page-link" href="{{ path('app_admin_utilisateur_list', {page: pagination.currentPage + 1}) }}">
                                Suivant <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="{{ path('app_admin_utilisateur_list', {page: pagination.totalPages}) }}">
                                Fin <i class="fas fa-step-forward"></i>
                            </a>
                        </li>
                    {% else %}
                        <li class="page-item disabled">
                            <span class="page-link">Suivant <i class="fas fa-chevron-right"></i></span>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link">Fin <i class="fas fa-step-forward"></i></span>
                        </li>
                    {% endif %}
                </ul>
            </nav>
        {% endif %}
    {% else %}
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> Aucun utilisateur enregistré. <a href="{{ path('app_admin_utilisateur_create') }}">Créer un nouveau</a>
        </div>
    {% endif %}
{% endblock %}
