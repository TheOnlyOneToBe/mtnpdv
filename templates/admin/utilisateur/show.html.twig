{% extends 'base.html.twig' %}

{% block title %}{{ utilisateur.prenomUt }} {{ utilisateur.nomUt }} - {{ app_name }}{% endblock %}

{% block body %}
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="mb-2">{{ utilisateur.prenomUt }} {{ utilisateur.nomUt }}</h1>
            <p class="text-muted">Détails du profil utilisateur</p>
        </div>
        <div class="col-md-4 text-end">
            <a href="{{ path('app_admin_utilisateur_edit', {id: utilisateur.id}) }}" class="btn btn-warning">
                <i class="fas fa-edit"></i> Modifier
            </a>
            <a href="{{ path('app_admin_utilisateur_list') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Retour
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="fas fa-info-circle"></i> Informations générales</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6>Email</h6>
                            <p><strong>{{ utilisateur.email.toString() }}</strong></p>
                        </div>
                        <div class="col-md-6">
                            <h6>Statut</h6>
                            <p>
                                <span class="badge bg-{% if utilisateur.statutUtilisateur.value == 'ACTIF' %}success{% elseif utilisateur.statutUtilisateur.value == 'INACTIF' %}danger{% else %}warning{% endif %}">
                                    {{ utilisateur.statutUtilisateur.value }}
                                </span>
                            </p>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6>Prénom</h6>
                            <p>{{ utilisateur.prenomUt }}</p>
                        </div>
                        <div class="col-md-6">
                            <h6>Nom</h6>
                            <p>{{ utilisateur.nomUt }}</p>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6>Téléphone</h6>
                            <p>{{ utilisateur.telephone.toString() }}</p>
                        </div>
                        <div class="col-md-6">
                            <h6>Date de création</h6>
                            <p>{{ utilisateur.dateCreation|date('d/m/Y H:i') }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="fas fa-lock"></i> Rôles et permissions</h5>
                </div>
                <div class="card-body">
                    {% if utilisateur.roles|length > 0 %}
                        <div class="mb-3">
                            <h6>Rôles assignés</h6>
                            <div>
                                {% for role in utilisateur.roles %}
                                    <span class="badge bg-primary me-2 mb-2">{{ role.codeRole }}: {{ role.libelleRole }}</span>
                                {% endfor %}
                            </div>
                        </div>
                    {% else %}
                        <div class="alert alert-warning mb-0">
                            <i class="fas fa-exclamation-triangle"></i> Aucun rôle assigné à cet utilisateur.
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="fas fa-cog"></i> Actions</h5>
                </div>
                <div class="card-body">
                    <form method="POST" action="{{ path('app_admin_utilisateur_delete', {id: utilisateur.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-user-' ~ utilisateur.id) }}">
                        <button type="submit" class="btn btn-danger w-100">
                            <i class="fas fa-trash"></i> Supprimer cet utilisateur
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
