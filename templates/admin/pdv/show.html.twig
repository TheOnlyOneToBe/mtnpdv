{% extends 'base.html.twig' %}

{% block title %}{{ pointVente.nomPdv }} - MTNPDV{% endblock %}

{% block body %}
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="mb-2">{{ pointVente.nomPdv }}</h1>
            <p class="text-muted">Détails du point de vente</p>
        </div>
        <div class="col-md-4 text-end">
            <a href="{{ path('app_admin_pdv_edit', {id: pointVente.id}) }}" class="btn btn-warning">
                <i class="fas fa-edit"></i> Modifier
            </a>
            <a href="{{ path('app_admin_pdv_list') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Retour
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="fas fa-info-circle"></i> Informations générales</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6>Code de référence</h6>
                            <p>{{ pointVente.codeRef }}</p>
                        </div>
                        <div class="col-md-6">
                            <h6>Statut</h6>
                            <p>
                                <span class="badge bg-{% if pointVente.statutActuel.value == 'ACTIF' %}success{% elseif pointVente.statutActuel.value == 'FERME' %}danger{% else %}warning{% endif %}">
                                    {{ pointVente.statutActuel.value }}
                                </span>
                            </p>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6>Ville</h6>
                            <p>{{ pointVente.ville }}</p>
                        </div>
                        <div class="col-md-6">
                            <h6>Adresse</h6>
                            <p>{{ pointVente.adresse ?? 'Non spécifiée' }}</p>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6>Téléphone</h6>
                            <p>{{ pointVente.telephone.toString() }}</p>
                        </div>
                        <div class="col-md-6">
                            <h6>Catégorie</h6>
                            <p>
                                {% if pointVente.categoriePdv %}
                                    {{ pointVente.categoriePdv.nomCategorie }}
                                {% else %}
                                    Non spécifiée
                                {% endif %}
                            </p>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6>Gérant</h6>
                            <p>
                                {% if pointVente.gerant %}
                                    {{ pointVente.gerant.prenomUt }} {{ pointVente.gerant.nomUt }}
                                {% else %}
                                    Aucun gérant assigné
                                {% endif %}
                            </p>
                        </div>
                        <div class="col-md-6">
                            <h6>Date de création</h6>
                            <p>{{ pointVente.dateCreation|date('d/m/Y H:i') }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="fas fa-map-marker-alt"></i> Localisation GPS</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6>Latitude</h6>
                            <p><code>{{ pointVente.coordonnees.latitude }}</code></p>
                        </div>
                        <div class="col-md-6">
                            <h6>Longitude</h6>
                            <p><code>{{ pointVente.coordonnees.longitude }}</code></p>
                        </div>
                    </div>
                    <div id="map" style="height: 400px; border-radius: 0.5rem; margin-top: 1rem;"></div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="fas fa-trash"></i> Actions</h5>
                </div>
                <div class="card-body">
                    <form method="POST" action="{{ path('app_admin_pdv_delete', {id: pointVente.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce point de vente?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-pdv-' ~ pointVente.id) }}">
                        <button type="submit" class="btn btn-danger w-100">
                            <i class="fas fa-trash"></i> Supprimer ce PDV
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        let map = L.map('map').setView([{{ pointVente.coordonnees.latitude }}, {{ pointVente.coordonnees.longitude }}], 15);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap',
            maxZoom: 19,
        }).addTo(map);

        L.marker([{{ pointVente.coordonnees.latitude }}, {{ pointVente.coordonnees.longitude }}], {
            icon: L.icon({
                iconUrl: 'data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCA0OCA0OCIgd2lkdGg9IjMyIiBoZWlnaHQ9IjMyIj48Y2lyY2xlIGN4PSIyNCIgY3k9IjI0IiByPSIyMiIgZmlsbD0iIzE2YTM0YSIvPjwvc3ZnPg==',
                iconSize: [32, 32],
                iconAnchor: [16, 32],
            })
        }).addTo(map).bindPopup('<strong>{{ pointVente.nomPdv }}</strong>');
    </script>
{% endblock %}
