{% extends 'base.html.twig' %}

{% block title %}
    {% if mode == 'create' %}
        Créer un point de vente - MTNPDV
    {% else %}
        Modifier {{ pointVente.nomPdv }} - MTNPDV
    {% endif %}
{% endblock %}

{% block body %}
    <div class="row mb-4">
        <div class="col-md-12">
            {% if mode == 'create' %}
                <h1 class="mb-2"><i class="fas fa-plus"></i> Créer un point de vente</h1>
            {% else %}
                <h1 class="mb-2"><i class="fas fa-edit"></i> Modifier {{ pointVente.nomPdv }}</h1>
            {% endif %}
            <p class="text-muted">Remplissez le formulaire ci-dessous</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    {{ form_start(form) }}

                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(form.nomPdv) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.codeRef) }}
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(form.latitude) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.longitude) }}
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(form.ville) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.adresse) }}
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(form.telephone) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.statutActuel) }}
                        </div>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a href="{{ path('app_admin_pdv_list') }}" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Annuler
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i>
                            {% if mode == 'create' %}
                                Créer le point de vente
                            {% else %}
                                Enregistrer les modifications
                            {% endif %}
                        </button>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="fas fa-info-circle"></i> Aide</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <h6>Localisation GPS</h6>
                        <p class="small text-muted">
                            Entrez les coordonnées GPS précises du point de vente. Vous pouvez utiliser une carte pour obtenir les coordonnées.
                        </p>
                    </div>
                    <div class="mb-3">
                        <h6>Code de référence</h6>
                        <p class="small text-muted">
                            Utilisez un code unique pour identifier rapidement ce point de vente dans le système.
                        </p>
                    </div>
                    <div class="mb-3">
                        <h6>Statut</h6>
                        <p class="small text-muted">
                            <strong>Actif:</strong> Le point de vente est opérationnel.<br>
                            <strong>Suspendu:</strong> Le point de vente est temporairement fermé.<br>
                            <strong>Fermé:</strong> Le point de vente est définitivement fermé.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
