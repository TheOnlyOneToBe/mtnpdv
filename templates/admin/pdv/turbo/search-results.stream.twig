<turbo-stream action="update" target="search-spinner">
  <template>
    <div id="search-spinner" class="text-center mb-3 d-none" data-pdv-search-target="spinner"></div>
  </template>
</turbo-stream>

{% if rateLimited %}
  <turbo-stream action="update" target="search-results">
    <template>
      <div id="search-results" data-pdv-search-target="results"></div>
    </template>
  </turbo-stream>

  <turbo-stream action="update" target="search-no-results">
    <template>
      <div id="search-no-results" class="alert alert-warning mt-3" data-pdv-search-target="noResults">
        <i class="fas fa-hourglass-end"></i>
        <strong>Limite de requêtes atteinte</strong><br>
        Trop de recherches effectuées. Veuillez patienter quelques instants avant de recommencer.
      </div>
    </template>
  </turbo-stream>
{% elseif hasResults %}
  <turbo-stream action="update" target="search-results">
    <template>
      <div class="list-group" id="search-results" data-pdv-search-target="results">
        {% for pdv in pointVentes %}
          <div class="list-group-item list-group-item-action"
               id="pdv-{{ pdv.id }}"
               data-action="click->pdv-map#centerOnPdv"
               data-pdv-id="{{ pdv.id }}">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div class="flex-grow-1">
                <h6 class="mb-1">
                  {{ pdv.nomPdv }}
                </h6>
                <small class="text-muted">{{ pdv.codeRef }}</small>
              </div>
              <span class="badge bg-{% if pdv.statutActuel.value == 'ACTIF' %}success{% elseif pdv.statutActuel.value == 'FERME' %}danger{% else %}warning{% endif %}">
                {{ pdv.statutActuel.libelle() }}
              </span>
            </div>
            <p class="mb-2 small">
              <i class="fas fa-location-dot me-1"></i> {{ pdv.ville }}
              {% if pdv.adresse %}
                <br><i class="fas fa-address-card me-1"></i> {{ pdv.adresse }}
              {% endif %}
            </p>
            <div class="d-flex gap-2">
              <a href="{{ path('app_admin_pdv_show', {id: pdv.id}) }}" class="btn btn-sm btn-info">
                <i class="fas fa-eye"></i>
              </a>
              <button class="btn btn-sm btn-warning"
                      data-action="pdv-form#openEditForm"
                      data-pdv-id="{{ pdv.id }}"
                      data-pdv-url="{{ path('app_admin_pdv_edit', {id: pdv.id}) }}">
                <i class="fas fa-edit"></i>
              </button>
              <form method="POST" action="{{ path('app_admin_pdv_delete', {id: pdv.id}) }}" style="display: inline;" data-action="pdv-list#handleDelete" data-pdv-name="{{ pdv.nomPdv }}" onclick="event.stopPropagation();">
                <input type="hidden" name="_token" value="{{ csrf_token('delete-pdv-' ~ pdv.id) }}">
                <button type="submit" class="btn btn-sm btn-danger">
                  <i class="fas fa-trash"></i>
                </button>
              </form>
            </div>
          </div>
        {% endfor %}
      </div>
    </template>
  </turbo-stream>

  <turbo-stream action="update" target="search-no-results">
    <template>
      <div id="search-no-results" class="d-none" data-pdv-search-target="noResults"></div>
    </template>
  </turbo-stream>

  <!-- Pagination (optional, keep if needed) -->
  {% if totalPages > 1 %}
    <turbo-stream action="after" target="search-results">
      <template>
        <nav aria-label="Pagination de recherche" class="d-flex justify-content-center mt-4">
          <ul class="pagination pagination-sm mb-0">
            {% if currentPage > 1 %}
              <li class="page-item">
                <button class="page-link"
                        data-action="pdv-search#performSearch"
                        data-pdv-search-page-value="1"
                        data-pdv-search-search-term-value="{{ searchTerm }}"
                        data-pdv-search-department-value="{{ department }}"
                        data-pdv-search-gerant-value="{{ gerant }}"
                        data-pdv-search-statut-value="{{ statut }}"
                        data-pdv-search-categorie-value="{{ categorie }}">
                  <i class="fas fa-step-backward"></i>
                </button>
              </li>
              <li class="page-item">
                <button class="page-link"
                        data-action="pdv-search#performSearch"
                        data-pdv-search-page-value="{{ currentPage - 1 }}"
                        data-pdv-search-search-term-value="{{ searchTerm }}"
                        data-pdv-search-department-value="{{ department }}"
                        data-pdv-search-gerant-value="{{ gerant }}"
                        data-pdv-search-statut-value="{{ statut }}"
                        data-pdv-search-categorie-value="{{ categorie }}">
                  <i class="fas fa-chevron-left"></i>
                </button>
              </li>
            {% endif %}

            {% for page in 1..totalPages %}
              {% if page == currentPage %}
                <li class="page-item active">
                  <span class="page-link">{{ page }}</span>
                </li>
              {% elseif page <= currentPage + 2 and page >= currentPage - 2 %}
                <li class="page-item">
                  <button class="page-link"
                          data-action="pdv-search#performSearch"
                          data-pdv-search-page-value="{{ page }}"
                          data-pdv-search-search-term-value="{{ searchTerm }}"
                          data-pdv-search-department-value="{{ department }}"
                          data-pdv-search-gerant-value="{{ gerant }}"
                          data-pdv-search-statut-value="{{ statut }}"
                          data-pdv-search-categorie-value="{{ categorie }}">
                    {{ page }}
                  </button>
                </li>
              {% elseif page == currentPage + 3 %}
                <li class="page-item disabled">
                  <span class="page-link">...</span>
                </li>
              {% endif %}
            {% endfor %}

            {% if currentPage < totalPages %}
              <li class="page-item">
                <button class="page-link"
                        data-action="pdv-search#performSearch"
                        data-pdv-search-page-value="{{ currentPage + 1 }}"
                        data-pdv-search-search-term-value="{{ searchTerm }}"
                        data-pdv-search-department-value="{{ department }}"
                        data-pdv-search-gerant-value="{{ gerant }}"
                        data-pdv-search-statut-value="{{ statut }}"
                        data-pdv-search-categorie-value="{{ categorie }}">
                  <i class="fas fa-chevron-right"></i>
                </button>
              </li>
              <li class="page-item">
                <button class="page-link"
                        data-action="pdv-search#performSearch"
                        data-pdv-search-page-value="{{ totalPages }}"
                        data-pdv-search-search-term-value="{{ searchTerm }}"
                        data-pdv-search-department-value="{{ department }}"
                        data-pdv-search-gerant-value="{{ gerant }}"
                        data-pdv-search-statut-value="{{ statut }}"
                        data-pdv-search-categorie-value="{{ categorie }}">
                  <i class="fas fa-step-forward"></i>
                </button>
              </li>
            {% endif %}
          </ul>
        </nav>
      </template>
    </turbo-stream>
  {% endif %}
{% else %}
  <turbo-stream action="update" target="search-results">
    <template>
      <div id="search-results" data-pdv-search-target="results"></div>
    </template>
  </turbo-stream>

  <turbo-stream action="update" target="search-no-results">
    <template>
      <div id="search-no-results" class="alert alert-info mt-3" data-pdv-search-target="noResults">
        <i class="fas fa-search"></i>
        <strong>Aucun résultat</strong><br>
        Aucun point de vente ne correspond aux critères de recherche.
      </div>
    </template>
  </turbo-stream>
{% endif %}
