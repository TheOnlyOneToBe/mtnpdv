<turbo-stream action="update" target="search-spinner">
  <template>
    <div id="search-spinner" class="text-center mb-3 d-none" data-pdv-search-target="spinner"></div>
  </template>
</turbo-stream>

{% if rateLimited %}
  <turbo-stream action="update" target="search-results">
    <template>
      <div id="search-results" data-pdv-search-target="results"></div>
    </template>
  </turbo-stream>

  <turbo-stream action="update" target="search-no-results">
    <template>
      <div id="search-no-results" class="alert alert-warning mt-3" data-pdv-search-target="noResults">
        <i class="fas fa-hourglass-end"></i>
        <strong>Limite de requêtes atteinte</strong><br>
        Trop de recherches effectuées. Veuillez patienter quelques instants avant de recommencer.
      </div>
    </template>
  </turbo-stream>
{% elseif hasResults %}
  <turbo-stream action="update" target="search-results">
    <template>
      <div class="row" id="search-results" data-pdv-search-target="results">
        {% for pdv in pointVentes %}
          <div class="col-md-6 mb-4" id="pdv-{{ pdv.id }}">
            <div class="card h-100 border-2 border-info">
              <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                  <i class="fas fa-search text-info"></i> {{ pdv.nomPdv }}
                </h5>
                <span class="badge bg-{% if pdv.statutActuel.value == 'ACTIF' %}success{% elseif pdv.statutActuel.value == 'FERME' %}danger{% else %}warning{% endif %}">
                  {{ pdv.statutActuel.value }}
                </span>
              </div>
              <div class="card-body">
                <p class="mb-2">
                  <strong><i class="fas fa-barcode"></i> Code:</strong> {{ pdv.codeRef }}
                </p>
                <p class="mb-2">
                  <strong><i class="fas fa-city"></i> Département/Ville:</strong> {{ pdv.ville }}
                </p>
                <p class="mb-2">
                  <strong><i class="fas fa-map-pin"></i> Adresse:</strong> {{ pdv.adresse ?? 'N/A' }}
                </p>
                <p class="mb-2">
                  <strong><i class="fas fa-phone"></i> Téléphone:</strong> {{ pdv.telephone.toString() }}
                </p>
                {% if pdv.gerant %}
                  <p class="mb-2">
                    <strong><i class="fas fa-user-tie"></i> Gérant:</strong> {{ pdv.gerant.prenomUt }} {{ pdv.gerant.nomUt }}
                  </p>
                {% endif %}
                <p class="mb-0">
                  <strong><i class="fas fa-satellite"></i> Coordonnées GPS:</strong><br>
                  <small class="text-muted">Lat: {{ pdv.coordonnees.latitude }} | Lng: {{ pdv.coordonnees.longitude }}</small>
                </p>
              </div>
              <div class="card-footer bg-light d-flex gap-2">
                <a href="{{ path('app_admin_pdv_show', {id: pdv.id}) }}" class="btn btn-sm btn-info">
                  <i class="fas fa-eye"></i> Détails
                </a>
                <a href="{{ path('app_admin_pdv_edit', {id: pdv.id}) }}" class="btn btn-sm btn-warning"><i class="fas fa-edit"></i> Modifier</a>
                <form method="POST" action="{{ path('app_admin_pdv_delete', {id: pdv.id}) }}" style="display: inline;" data-action="pdv-list#handleDelete" data-pdv-name="{{ pdv.nomPdv }}">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete-pdv-' ~ pdv.id) }}">
                  <button type="submit" class="btn btn-sm btn-danger">
                    <i class="fas fa-trash"></i> Supprimer
                  </button>
                </form>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </template>
  </turbo-stream>

  <turbo-stream action="update" target="search-pagination">
    <template>
      {% if totalPages > 1 %}
        <nav aria-label="Pagination de recherche" class="d-flex justify-content-center mt-4">
          <ul class="pagination mb-0">
            {% if currentPage > 1 %}
              <li class="page-item">
                <button class="page-link"
                        data-action="pdv-search#performSearch"
                        data-pdv-search-page-value="1"
                        data-pdv-search-search-term-value="{{ searchTerm }}"
                        data-pdv-search-department-value="{{ department }}"
                        data-pdv-search-gerant-value="{{ gerant }}">
                  <i class="fas fa-chevron-left"></i> Première
                </button>
              </li>
              <li class="page-item">
                <button class="page-link"
                        data-action="pdv-search#performSearch"
                        data-pdv-search-page-value="{{ currentPage - 1 }}"
                        data-pdv-search-search-term-value="{{ searchTerm }}"
                        data-pdv-search-department-value="{{ department }}"
                        data-pdv-search-gerant-value="{{ gerant }}">
                  <i class="fas fa-angle-left"></i>
                </button>
              </li>
            {% endif %}

            {% for page in 1..totalPages %}
              {% if page == currentPage %}
                <li class="page-item active">
                  <span class="page-link">{{ page }}</span>
                </li>
              {% elseif page <= currentPage + 2 and page >= currentPage - 2 %}
                <li class="page-item">
                  <button class="page-link"
                          data-action="pdv-search#performSearch"
                          data-pdv-search-page-value="{{ page }}"
                          data-pdv-search-search-term-value="{{ searchTerm }}"
                          data-pdv-search-department-value="{{ department }}"
                          data-pdv-search-gerant-value="{{ gerant }}">
                    {{ page }}
                  </button>
                </li>
              {% elseif page == currentPage + 3 %}
                <li class="page-item disabled">
                  <span class="page-link">...</span>
                </li>
              {% endif %}
            {% endfor %}

            {% if currentPage < totalPages %}
              <li class="page-item">
                <button class="page-link"
                        data-action="pdv-search#performSearch"
                        data-pdv-search-page-value="{{ currentPage + 1 }}"
                        data-pdv-search-search-term-value="{{ searchTerm }}"
                        data-pdv-search-department-value="{{ department }}"
                        data-pdv-search-gerant-value="{{ gerant }}">
                  <i class="fas fa-angle-right"></i>
                </button>
              </li>
              <li class="page-item">
                <button class="page-link"
                        data-action="pdv-search#performSearch"
                        data-pdv-search-page-value="{{ totalPages }}"
                        data-pdv-search-search-term-value="{{ searchTerm }}"
                        data-pdv-search-department-value="{{ department }}"
                        data-pdv-search-gerant-value="{{ gerant }}">
                  Dernière <i class="fas fa-chevron-right"></i>
                </button>
              </li>
            {% endif %}
          </ul>
        </nav>
        <div class="text-center text-muted small mt-3">
          Affichage {{ (currentPage - 1) * resultsPerPage + 1 }} à {{ min(currentPage * resultsPerPage, totalResults) }} sur {{ totalResults }} résultats
        </div>
      {% endif %}
    </template>
  </turbo-stream>

  <turbo-stream action="add" target="search-no-results" class="d-none">
    <template></template>
  </turbo-stream>
{% else %}
  <turbo-stream action="update" target="search-results">
    <template>
      <div id="search-results" data-pdv-search-target="results"></div>
    </template>
  </turbo-stream>

  <turbo-stream action="update" target="search-pagination">
    <template></template>
  </turbo-stream>

  <turbo-stream action="update" target="search-no-results">
    <template>
      <div id="search-no-results" class="alert alert-info mt-3" data-pdv-search-target="noResults">
        <i class="fas fa-search"></i>
        <strong>Aucun résultat</strong><br>
        {% if searchTerm %}
          Aucun point de vente trouvé pour: <strong>{{ searchTerm }}</strong>
        {% elseif department %}
          Aucun point de vente dans: <strong>{{ department }}</strong>
        {% elseif gerant %}
          Aucun point de vente pour ce gérant
        {% endif %}
      </div>
    </template>
  </turbo-stream>
{% endif %}
