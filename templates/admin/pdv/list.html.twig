{% extends 'base.html.twig' %}

{% block title %}Points de vente - MTNPDV{% endblock %}

{% block body %}
    <div data-controller="pdv-list pdv-form pdv-search pdv-map"
         data-pdv-form-submit-url-value="{{ path('app_admin_pdv_create') }}"
         data-pdv-search-search-url-value="{{ path('app_admin_pdv_search') }}"
         data-pdv-map-center-lat-value="3.8480"
         data-pdv-map-center-lng-value="11.5021"
         data-pdv-map-zoom-level-value="6">
        <div id="pdv-alerts"></div>

        <div class="row mb-4">
            <div class="col-md-6">
                <h1 class="mb-2"><i class="fas fa-store"></i> Points de vente</h1>
                <p class="text-muted">Gérez vos points de vente</p>
            </div>
            <div class="col-md-6 text-end">
                <button class="btn btn-primary me-2" data-action="pdv-form#openCreateForm">
                    <i class="fas fa-plus"></i> Nouveau point de vente
                </button>
                <div class="btn-group" role="group">
                    <button type="button" class="btn btn-outline-secondary active" data-action="pdv-map#toggleView" data-view="list" data-pdv-map-target="viewToggle">
                        <i class="fas fa-list"></i> Liste
                    </button>
                    <button type="button" class="btn btn-outline-secondary" data-action="pdv-map#toggleView" data-view="map" data-pdv-map-target="viewToggle">
                        <i class="fas fa-map"></i> Carte
                    </button>
                </div>
            </div>
        </div>

        <!-- Formulaire de Recherche et Filtrage -->
        <div class="row mb-4">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="fas fa-search"></i> Rechercher et filtrer</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-5">
                                <label for="search-input" class="form-label">
                                    <i class="fas fa-magnifying-glass"></i> Rechercher par nom ou code
                                </label>
                                <input type="text"
                                       class="form-control form-control-lg"
                                       id="search-input"
                                       data-pdv-search-target="searchInput"
                                       data-action="pdv-search#onSearchInput"
                                       placeholder="Entrez le nom ou le code du PDV..."
                                       autocomplete="off">
                                <small class="text-muted">Recherche en temps réel</small>
                            </div>
                            <div class="col-md-3">
                                <label for="department-select" class="form-label">
                                    <i class="fas fa-map"></i> Région/Département
                                </label>
                                <select class="form-select form-select-lg"
                                        id="department-select"
                                        data-pdv-search-target="departmentSelect"
                                        data-action="pdv-search#onFilterChange">
                                    <option value="">-- Tous les départements --</option>
                                    <option value="Yaoundé">Yaoundé</option>
                                    <option value="Douala">Douala</option>
                                    <option value="Buea">Buea</option>
                                    <option value="Bamenda">Bamenda</option>
                                    <option value="Garoua">Garoua</option>
                                    <option value="Bafoussam">Bafoussam</option>
                                    <option value="Kumba">Kumba</option>
                                    <option value="Limbe">Limbe</option>
                                    <option value="Kribi">Kribi</option>
                                    <option value="Ebolowa">Ebolowa</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="gerant-select" class="form-label">
                                    <i class="fas fa-user-tie"></i> Gérant
                                </label>
                                <select class="form-select form-select-lg"
                                        id="gerant-select"
                                        data-pdv-search-target="gerantSelect"
                                        data-action="pdv-search#onFilterChange">
                                    <option value="">-- Tous les gérants --</option>
                                    <option value="">Charger les gérants...</option>
                                </select>
                            </div>
                        </div>
                        <div class="mt-3 text-end">
                            <small class="text-muted">
                                <i class="fas fa-info-circle"></i> Les résultats s'affichent en temps réel ci-dessous
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section Résultats de Recherche -->
        <div class="row mb-4" id="search-section" style="display: none;">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="fas fa-filter"></i> Résultats de recherche</h5>
                    </div>
                    <div class="card-body">
                        <div id="search-spinner" class="text-center mb-3 d-none">
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            <span class="ms-2">Recherche en cours...</span>
                        </div>
                        <div id="search-results"></div>
                        <div id="search-no-results"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Liste View -->
        <div data-pdv-map-target="listView">
            {% if pointVentes|length > 0 %}
                <div class="row" id="pdv-list">
                    {% for pdv in pointVentes %}
                        <div class="col-md-6 mb-4" id="pdv-{{ pdv.id }}">
                            <div class="card h-100">
                                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0">{{ pdv.nomPdv }}</h5>
                                    <span class="badge bg-{% if pdv.statutActuel.value == 'ACTIF' %}success{% elseif pdv.statutActuel.value == 'FERME' %}danger{% else %}warning{% endif %}">
                                        {{ pdv.statutActuel.value }}
                                    </span>
                                </div>
                                <div class="card-body">
                                    <p class="mb-2">
                                        <strong>Code:</strong> {{ pdv.codeRef }}
                                    </p>
                                    <p class="mb-2">
                                        <strong>Ville:</strong> {{ pdv.ville }}
                                    </p>
                                    <p class="mb-2">
                                        <strong>Adresse:</strong> {{ pdv.adresse ?? 'N/A' }}
                                    </p>
                                    <p class="mb-2">
                                        <strong>Téléphone:</strong> {{ pdv.telephone.toString() }}
                                    </p>
                                    {% if pdv.gerant %}
                                        <p class="mb-2">
                                            <strong>Gérant:</strong> {{ pdv.gerant.prenomUt }} {{ pdv.gerant.nomUt }}
                                        </p>
                                    {% endif %}
                                    <p class="mb-0">
                                        <strong>Coordonnées GPS:</strong><br>
                                        Lat: {{ pdv.coordonnees.latitude }}<br>
                                        Lng: {{ pdv.coordonnees.longitude }}
                                    </p>
                                </div>
                                <div class="card-footer bg-light d-flex gap-2">
                                    <a href="{{ path('app_admin_pdv_show', {id: pdv.id}) }}" class="btn btn-sm btn-info">
                                        <i class="fas fa-eye"></i> Détails
                                    </a>
                                    <button class="btn btn-sm btn-warning"
                                            data-action="pdv-form#openEditForm"
                                            data-pdv-id="{{ pdv.id }}"
                                            data-pdv-url="{{ path('app_admin_pdv_edit', {id: pdv.id}) }}">
                                        <i class="fas fa-edit"></i> Modifier
                                    </button>
                                    <form method="POST" action="{{ path('app_admin_pdv_delete', {id: pdv.id}) }}" style="display: inline;" data-action="pdv-list#handleDelete" data-pdv-name="{{ pdv.nomPdv }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-pdv-' ~ pdv.id) }}">
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="fas fa-trash"></i> Supprimer
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div id="empty-state" class="alert alert-info">
                    <i class="fas fa-info-circle"></i> Aucun point de vente enregistré.
                    <button class="btn btn-link" data-action="pdv-form#openCreateForm">Créer un nouveau</button>
                </div>
            {% endif %}
        </div>

        <!-- Map View -->
        <div data-pdv-map-target="mapView" class="d-none" style="height: 600px; border-radius: 0.5rem; overflow: hidden;">
            <div id="map-container" data-pdv-map-target="mapContainer" style="width: 100%; height: 100%;"></div>
        </div>
    </div>

    <!-- Modal pour le formulaire PDV -->
    <div class="modal fade" id="pdvModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-store"></i> Point de vente
                    </h5>
                    <button type="button" class="btn-close" data-action="pdv-form#closeModal"></button>
                </div>
                <div id="pdv-form-modal-body" class="modal-body">
                    <p class="text-center">
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        Chargement du formulaire...
                    </p>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Initialiser le modal et les contrôleurs
        document.addEventListener('DOMContentLoaded', function() {
            const pdvFormElement = document.querySelector('[data-controller*="pdv-form"]');
            if (pdvFormElement) {
                const pdvForm = Stimulus.Application.current.getControllerForElementAndIdentifier(pdvFormElement, 'pdv-form');
                if (pdvForm) {
                    pdvForm.modalTarget = document.getElementById('pdvModal');
                    pdvForm.spinnerTarget = document.getElementById('pdv-form-spinner') || document.createElement('div');
                }
            }
        });
    </script>
{% endblock %}
