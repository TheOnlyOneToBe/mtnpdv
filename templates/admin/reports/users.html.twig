{% extends 'base.html.twig' %}

{% block title %}Rapport Utilisateurs - MTNPDV{% endblock %}

{% block body %}
    <div class="container-lg py-5">
        <div class="row mb-4">
            <div class="col-md-8">
                <h1 class="mb-2"><i class="fas fa-users"></i> Rapport Utilisateurs</h1>
                <p class="text-muted">Analyse détaillée des utilisateurs et de leurs rôles</p>
            </div>
            <div class="col-md-4 text-end">
                <a href="{{ path('app_admin_reports') }}" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Retour
                </a>
            </div>
        </div>

        <!-- Résumé des statistiques -->
        <div class="row mb-4">
            <div class="col-md-3 mb-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h2 class="card-title text-primary">{{ statistics.totalUsers }}</h2>
                        <p class="card-text text-muted">Total des utilisateurs</p>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h2 class="card-title text-danger">{{ statistics.usersByRole.ADMIN }}</h2>
                        <p class="card-text text-muted">Administrateurs</p>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h2 class="card-title text-info">{{ statistics.usersByRole.AGENT }}</h2>
                        <p class="card-text text-muted">Agents</p>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h2 class="card-title text-success">{{ statistics.usersByRole.GERANT }}</h2>
                        <p class="card-text text-muted">Gérants</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Distribution par rôle -->
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="fas fa-chart-pie"></i> Distribution par rôle</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th><i class="fas fa-badge"></i> Rôle</th>
                                <th class="text-center"><i class="fas fa-chart-bar"></i> Nombre</th>
                                <th class="text-center"><i class="fas fa-percent"></i> Pourcentage</th>
                                <th><i class="fas fa-chart-pie"></i> Visualisation</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% set totalUsers = statistics.usersByRole.ADMIN + statistics.usersByRole.AGENT + statistics.usersByRole.GERANT %}
                            <tr>
                                <td>
                                    <span class="badge bg-danger"><i class="fas fa-user-shield"></i> Administrateur</span>
                                </td>
                                <td class="text-center">{{ statistics.usersByRole.ADMIN }}</td>
                                <td class="text-center">
                                    {% if totalUsers > 0 %}
                                        {{ ((statistics.usersByRole.ADMIN / totalUsers) * 100)|round(1) }}%
                                    {% else %}
                                        0%
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="progress" style="height: 20px;">
                                        <div class="progress-bar bg-danger"
                                             role="progressbar"
                                             style="width: {% if totalUsers > 0 %}{{ ((statistics.usersByRole.ADMIN / totalUsers) * 100)|round(1) }}{% else %}0{% endif %}%">
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <span class="badge bg-info"><i class="fas fa-user-secret"></i> Agent commercial</span>
                                </td>
                                <td class="text-center">{{ statistics.usersByRole.AGENT }}</td>
                                <td class="text-center">
                                    {% if totalUsers > 0 %}
                                        {{ ((statistics.usersByRole.AGENT / totalUsers) * 100)|round(1) }}%
                                    {% else %}
                                        0%
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="progress" style="height: 20px;">
                                        <div class="progress-bar bg-info"
                                             role="progressbar"
                                             style="width: {% if totalUsers > 0 %}{{ ((statistics.usersByRole.AGENT / totalUsers) * 100)|round(1) }}{% else %}0{% endif %}%">
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <span class="badge bg-success"><i class="fas fa-user-tie"></i> Gérant du kiosque</span>
                                </td>
                                <td class="text-center">{{ statistics.usersByRole.GERANT }}</td>
                                <td class="text-center">
                                    {% if totalUsers > 0 %}
                                        {{ ((statistics.usersByRole.GERANT / totalUsers) * 100)|round(1) }}%
                                    {% else %}
                                        0%
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="progress" style="height: 20px;">
                                        <div class="progress-bar bg-success"
                                             role="progressbar"
                                             style="width: {% if totalUsers > 0 %}{{ ((statistics.usersByRole.GERANT / totalUsers) * 100)|round(1) }}{% else %}0{% endif %}%">
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Descriptions des rôles -->
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="fas fa-info-circle"></i> Description des rôles</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <div class="card border-danger">
                            <div class="card-header bg-danger text-white">
                                <i class="fas fa-user-shield"></i> Administrateur
                            </div>
                            <div class="card-body">
                                <p class="small">
                                    Accès complet au système. Gestion des utilisateurs, PDV, transactions et configurations.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <div class="card border-info">
                            <div class="card-header bg-info text-white">
                                <i class="fas fa-user-secret"></i> Agent
                            </div>
                            <div class="card-body">
                                <p class="small">
                                    Accès aux fonctionnalités terrain. Enregistrement de visites et gestion des transactions.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <div class="card border-success">
                            <div class="card-header bg-success text-white">
                                <i class="fas fa-user-tie"></i> Gérant
                            </div>
                            <div class="card-body">
                                <p class="small">
                                    Accès limité à son kiosque. Consultation des données et historique des transactions.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="row mt-4">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body">
                        <a href="{{ path('app_admin_utilisateur_list') }}" class="btn btn-primary">
                            <i class="fas fa-list"></i> Voir la liste des utilisateurs
                        </a>
                        <a href="{{ path('app_admin_dashboard') }}" class="btn btn-secondary">
                            <i class="fas fa-chart-line"></i> Retour au dashboard
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
