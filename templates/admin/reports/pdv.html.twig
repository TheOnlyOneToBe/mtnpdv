{% extends 'base.html.twig' %}

{% block title %}Rapport PDV - MTNPDV{% endblock %}

{% block body %}
    <div class="container-lg py-5">
        <div class="row mb-4">
            <div class="col-md-8">
                <h1 class="mb-2"><i class="fas fa-store"></i> Rapport Points de Vente</h1>
                <p class="text-muted">Analyse détaillée des points de vente du réseau</p>
            </div>
            <div class="col-md-4 text-end">
                <a href="{{ path('app_admin_reports') }}" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Retour
                </a>
            </div>
        </div>

        <!-- Résumé des statistiques -->
        <div class="row mb-4">
            <div class="col-md-4 mb-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h2 class="card-title text-primary">{{ statistics.totalPdv }}</h2>
                        <p class="card-text text-muted">Total des points de vente</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h2 class="card-title text-success">{{ statistics.pdvByStatus.ACTIF }}</h2>
                        <p class="card-text text-muted">Points de vente actifs</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h2 class="card-title text-danger">{{ statistics.pdvByStatus.FERME }}</h2>
                        <p class="card-text text-muted">Points de vente fermés</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Détails par statut -->
        <div class="card">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="fas fa-chart-doughnut"></i> Distribution par statut</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th><i class="fas fa-badge"></i> Statut</th>
                                <th class="text-center"><i class="fas fa-chart-bar"></i> Nombre</th>
                                <th class="text-center"><i class="fas fa-percent"></i> Pourcentage</th>
                                <th><i class="fas fa-chart-pie"></i> Visualisation</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% set totalPdv = statistics.pdvByStatus.ACTIF + statistics.pdvByStatus.FERME + statistics.pdvByStatus.SUSPENDU %}
                            <tr>
                                <td>
                                    <span class="badge bg-success"><i class="fas fa-check-circle"></i> Actif</span>
                                </td>
                                <td class="text-center">{{ statistics.pdvByStatus.ACTIF }}</td>
                                <td class="text-center">
                                    {% if totalPdv > 0 %}
                                        {{ ((statistics.pdvByStatus.ACTIF / totalPdv) * 100)|round(1) }}%
                                    {% else %}
                                        0%
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="progress" style="height: 20px;">
                                        <div class="progress-bar bg-success"
                                             role="progressbar"
                                             style="width: {% if totalPdv > 0 %}{{ ((statistics.pdvByStatus.ACTIF / totalPdv) * 100)|round(1) }}{% else %}0{% endif %}%">
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <span class="badge bg-danger"><i class="fas fa-lock"></i> Fermé</span>
                                </td>
                                <td class="text-center">{{ statistics.pdvByStatus.FERME }}</td>
                                <td class="text-center">
                                    {% if totalPdv > 0 %}
                                        {{ ((statistics.pdvByStatus.FERME / totalPdv) * 100)|round(1) }}%
                                    {% else %}
                                        0%
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="progress" style="height: 20px;">
                                        <div class="progress-bar bg-danger"
                                             role="progressbar"
                                             style="width: {% if totalPdv > 0 %}{{ ((statistics.pdvByStatus.FERME / totalPdv) * 100)|round(1) }}{% else %}0{% endif %}%">
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <span class="badge bg-warning"><i class="fas fa-pause-circle"></i> Suspendu</span>
                                </td>
                                <td class="text-center">{{ statistics.pdvByStatus.SUSPENDU }}</td>
                                <td class="text-center">
                                    {% if totalPdv > 0 %}
                                        {{ ((statistics.pdvByStatus.SUSPENDU / totalPdv) * 100)|round(1) }}%
                                    {% else %}
                                        0%
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="progress" style="height: 20px;">
                                        <div class="progress-bar bg-warning"
                                             role="progressbar"
                                             style="width: {% if totalPdv > 0 %}{{ ((statistics.pdvByStatus.SUSPENDU / totalPdv) * 100)|round(1) }}{% else %}0{% endif %}%">
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="row mt-4">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body">
                        <a href="{{ path('app_admin_pdv_list') }}" class="btn btn-primary">
                            <i class="fas fa-list"></i> Voir la liste complète des PDV
                        </a>
                        <a href="{{ path('app_admin_dashboard') }}" class="btn btn-secondary">
                            <i class="fas fa-chart-line"></i> Retour au dashboard
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
