{% extends 'base.html.twig' %}

{% block title %}Nouvelle Visite - MTNPDV{% endblock %}

{% block body %}
    <div class="container-lg py-4">
        <div class="row">
            <div class="col-md-8 offset-md-2">
                <!-- Header -->
                <div class="mb-4">
                    <h1 class="mb-2"><i class="fas fa-plus-circle"></i> Enregistrer une Visite</h1>
                    <p class="text-muted">Complétez le formulaire pour enregistrer une nouvelle visite.</p>
                </div>

                <!-- Carte & Géolocalisation -->
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="fas fa-map-marker-alt"></i> Localisation</h5>
                    </div>
                    <div class="card-body">
                        <div id="visit-map" style="height: 300px; border-radius: 0.5rem; margin-bottom: 1rem;"></div>
                        <button type="button" class="btn btn-primary" onclick="getGeolocation()">
                            <i class="fas fa-crosshairs"></i> Obtenir ma position actuelle
                        </button>
                        <div id="geoLocation" class="mt-2 text-muted small" style="display:none;">
                            <p>Position: <span id="geoCoords"></span></p>
                        </div>
                    </div>
                </div>

                <!-- Form -->
                {{ form_start(form, { 'attr': { 'class': 'needs-validation', 'novalidate': true } }) }}

                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0"><i class="fas fa-info-circle"></i> Informations de la Visite</h5>
                        </div>
                        <div class="card-body">
                            <!-- Point de Vente -->
                            <div class="mb-3">
                                {{ form_label(form.pointVente) }}
                                {{ form_widget(form.pointVente, {
                                    'attr': { 'class': 'form-select' }
                                }) }}
                                {{ form_errors(form.pointVente) }}
                            </div>

                            <!-- Type -->
                            <div class="mb-3">
                                {{ form_label(form.type) }}
                                {{ form_widget(form.type, {
                                    'attr': { 'class': 'form-select' }
                                }) }}
                                {{ form_errors(form.type) }}
                            </div>

                            <!-- Montant -->
                            <div class="mb-3">
                                {{ form_label(form.montant) }}
                                <div class="input-group">
                                    {{ form_widget(form.montant, {
                                        'attr': { 'class': 'form-control', 'placeholder': '0.00' }
                                    }) }}
                                    <span class="input-group-text">€</span>
                                </div>
                                {{ form_errors(form.montant) }}
                            </div>

                            <!-- Commentaire -->
                            <div class="mb-3">
                                {{ form_label(form.commentaire) }}
                                {{ form_widget(form.commentaire, {
                                    'attr': { 'class': 'form-control', 'rows': 4 }
                                }) }}
                                {{ form_errors(form.commentaire) }}
                            </div>

                            <!-- Photo Preuve -->
                            {% if form.photoPreuve is defined %}
                                <div class="mb-3">
                                    {{ form_label(form.photoPreuve) }}
                                    {{ form_widget(form.photoPreuve, {
                                        'attr': { 'class': 'form-control', 'accept': 'image/*' }
                                    }) }}
                                    {{ form_errors(form.photoPreuve) }}
                                    <small class="form-text text-muted">
                                        Prise en charge: JPG, PNG, WebP (max 5MB)
                                    </small>
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Boutons -->
                    <div class="mb-4">
                        {{ form_widget(form.submit, {
                            'attr': { 'class': 'btn btn-success btn-lg me-2' }
                        }) }}
                        <a href="{{ path('app_agent_dashboard') }}" class="btn btn-secondary btn-lg">
                            <i class="fas fa-times"></i> Annuler
                        </a>
                    </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>

    <script>
        function getGeolocation() {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    function(position) {
                        const lat = position.coords.latitude;
                        const lng = position.coords.longitude;
                        document.getElementById('geoCoords').textContent = lat.toFixed(4) + ', ' + lng.toFixed(4);
                        document.getElementById('geoLocation').style.display = 'block';
                        // Update map
                        if (window.visitMap) {
                            window.visitMap.setView([lat, lng], 15);
                            L.marker([lat, lng]).addTo(window.visitMap);
                        }
                    },
                    function(error) {
                        alert('Erreur de géolocalisation: ' + error.message);
                    }
                );
            } else {
                alert('La géolocalisation n\'est pas supportée par votre navigateur.');
            }
        }

        // Initialize map
        window.visitMap = L.map('visit-map').setView([3.8480, 11.5021], 13);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap contributors'
        }).addTo(window.visitMap);
    </script>
{% endblock %}
