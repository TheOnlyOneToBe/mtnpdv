{% extends 'base.html.twig' %}

{% block title %}Mes Visites - MTNPDV{% endblock %}

{% block body %}
    <div class="container-lg py-4">
        <!-- Header -->
        <div class="row mb-4">
            <div class="col-md-8">
                <h1 class="mb-2"><i class="fas fa-list-check"></i> Mes Visites</h1>
                <p class="text-muted">Liste complète de toutes vos visites.</p>
            </div>
            <div class="col-md-4 text-end">
                <a href="{{ path('app_agent_visite_create') }}" class="btn btn-success me-2">
                    <i class="fas fa-plus"></i> Nouvelle visite
                </a>
                <a href="{{ path('app_agent_dashboard') }}" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Retour
                </a>
            </div>
        </div>

        <!-- Filtres -->
        <div class="card mb-4">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <label class="form-label">Filtrer par statut:</label>
                        <div class="btn-group w-100" role="group">
                            <a href="{{ path('app_agent_visite_list') }}" 
                               class="btn btn-sm {% if not statut %}btn-primary{% else %}btn-outline-primary{% endif %}">
                                Tous
                            </a>
                            <a href="{{ path('app_agent_visite_list', {statut: 'EN_ATTENTE'}) }}" 
                               class="btn btn-sm {% if statut == 'EN_ATTENTE' %}btn-warning{% else %}btn-outline-warning{% endif %}">
                                En Attente
                            </a>
                            <a href="{{ path('app_agent_visite_list', {statut: 'VALIDEE'}) }}" 
                               class="btn btn-sm {% if statut == 'VALIDEE' %}btn-success{% else %}btn-outline-success{% endif %}">
                                Validées
                            </a>
                            <a href="{{ path('app_agent_visite_list', {statut: 'REJETEE'}) }}" 
                               class="btn btn-sm {% if statut == 'REJETEE' %}btn-danger{% else %}btn-outline-danger{% endif %}">
                                Rejetées
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tableau des visites -->
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th><i class="fas fa-map-marker-alt"></i> Point de Vente</th>
                            <th><i class="fas fa-calendar"></i> Date</th>
                            <th><i class="fas fa-info-circle"></i> Type</th>
                            <th><i class="fas fa-euro-sign"></i> Montant</th>
                            <th><i class="fas fa-badge"></i> Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if visites|length > 0 %}
                            {% for visite in visites %}
                                <tr>
                                    <td><strong>{{ visite.getPointVente().getNomPdv() }}</strong></td>
                                    <td>{{ visite.getDateCreation()|date('d/m/Y H:i') }}</td>
                                    <td>{{ visite.getType().name }}</td>
                                    <td>{{ visite.getMontant() ? visite.getMontant().getValeur() / 100 ~ ' €' : '-' }}</td>
                                    <td>
                                        <span class="badge
                                            {% if visite.getStatut().name == 'VALIDEE' %}
                                                bg-success
                                            {% elseif visite.getStatut().name == 'REJETEE' %}
                                                bg-danger
                                            {% else %}
                                                bg-warning
                                            {% endif %}">
                                            {{ visite.getStatut().name }}
                                        </span>
                                    </td>
                                    <td>
                                        <a href="{{ path('app_agent_visite_show', {id: visite.getId()}) }}" 
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    <i class="fas fa-inbox fa-3x mb-2 opacity-50"></i>
                                    <p>Aucune visite trouvée</p>
                                </td>
                            </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        {% if pagination.totalPages > 1 %}
            <nav class="mt-4" aria-label="Pagination">
                <ul class="pagination justify-content-center">
                    {% if pagination.hasPreviousPage %}
                        <li class="page-item">
                            <a class="page-link" href="{{ path('app_agent_visite_list', {page: pagination.currentPage - 1, statut: statut}) }}">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>
                    {% endif %}

                    {% for pageNum in pageMetadata.pageNumbers %}
                        {% if pageNum is null %}
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        {% else %}
                            <li class="page-item {% if pageNum == pagination.currentPage %}active{% endif %}">
                                <a class="page-link" href="{{ path('app_agent_visite_list', {page: pageNum, statut: statut}) }}">
                                    {{ pageNum }}
                                </a>
                            </li>
                        {% endif %}
                    {% endfor %}

                    {% if pagination.hasNextPage %}
                        <li class="page-item">
                            <a class="page-link" href="{{ path('app_agent_visite_list', {page: pagination.currentPage + 1, statut: statut}) }}">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    {% endif %}
                </ul>
            </nav>
        {% endif %}

        <!-- Item range info -->
        {% if visites|length > 0 %}
            <div class="text-center mt-3 text-muted small">
                Affichage {{ itemRange.start }} à {{ itemRange.end }} de {{ pagination.totalItems }} visites
            </div>
        {% endif %}
    </div>
{% endblock %}
