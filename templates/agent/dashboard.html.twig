{% extends 'base.html.twig' %}

{% block title %}Dashboard Agent - {{ app_name }}{% endblock %}

{% block body %}
    <div data-controller="pdv-map"
 data-pdv-map-pdvs-value="{{ pointVentesData|json_encode }}"
 data-pdv-map-user-value="{{ userCoordinates|json_encode }}">

        <div class="container-lg py-4">
            <!-- Header -->
            <div class="row mb-4">
                <div class="col-md-8">
                    <h1 class="mb-2"><i class="fas fa-map-marked-alt"></i> Tableau de Bord Agent</h1>
                    <p class="text-muted">Bienvenue, {{ app.user.prenomUt }}! Vos visites en temps réel.</p>
                </div>
                <div class="col-md-4 text-end">
                    <a href="{{ path('app_profil_show') }}" class="btn btn-secondary">
                        <i class="fas fa-user"></i> Profil
                    </a>
                </div>
            </div>

            <!-- Key Metrics -->
            <div class="row mb-4">
                <div class="col-md-2 mb-3">
                    <div class="card text-white bg-primary">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <p class="card-text opacity-75">Total Visites</p>
                                    <h3 class="mb-0">{{ statistics.totalVisites }}</h3>
                                </div>
                                <i class="fas fa-check fa-3x opacity-25"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-2 mb-3">
                    <div class="card text-white bg-warning">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <p class="card-text opacity-75">En Attente</p>
                                    <h3 class="mb-0">{{ statistics.visitesEnAttente }}</h3>
                                </div>
                                <i class="fas fa-hourglass-half fa-3x opacity-25"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-2 mb-3">
                    <div class="card text-white bg-success">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <p class="card-text opacity-75">Validées</p>
                                    <h3 class="mb-0">{{ statistics.visitesValidees }}</h3>
                                </div>
                                <i class="fas fa-check-circle fa-3x opacity-25"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-2 mb-3">
                    <div class="card text-white bg-danger">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <p class="card-text opacity-75">Rejetées</p>
                                    <h3 class="mb-0">{{ statistics.visitesRejetees }}</h3>
                                </div>
                                <i class="fas fa-times-circle fa-3x opacity-25"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-2 mb-3">
                    <div class="card text-white bg-info">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <p class="card-text opacity-75">Appro. en Attente</p>
                                    <h3 class="mb-0">{{ pendingApprovisionnementsCount }}</h3>
                                </div>
                                <i class="fas fa-truck fa-3x opacity-25"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Map & Recent Visites / Approvisionnements Row -->
            <div class="row mb-4">
                <!-- Carte Interactive (50%) -->
                <div class="col-md-6 mb-3">
                    <div class="card">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="fas fa-map text-primary"></i> Carte Interactive
                            </h5>
                        </div>
                        <div class="card-body p-0" style="height: 500px;">
                            <div id="agent-map"
                                 data-pdv-map-target="mapContainer"
                                 style="width: 100%; height: 100%; border-radius: 0 0 0.5rem 0.5rem;">
                            </div>
                        </div>
                    </div>
                    <div class="card mt-3">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4 text-center">
                                    <span style="display: inline-block; width: 20px; height: 20px; background-color: #3388ff; border-radius: 50%;"></span>
                                    <small>Ma position</small>
                                </div>
                                <div class="col-md-4 text-center">
                                    <span style="display: inline-block; width: 20px; height: 20px; background-color: #22b14c; border-radius: 50%;"></span>
                                    <small>PDV actifs</small>
                                </div>
                                <div class="col-md-4 text-center">
                                    <span style="display: inline-block; width: 20px; height: 20px; background-color: #ff5722; border-radius: 50%;"></span>
                                    <small>Mes visites</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recent Visites & Approvisionnements -->
                <div class="col-md-6 mb-3">
                    <div class="row">
                        <!-- Recent Visites -->
                        <div class="col-md-12 mb-3">
                            <div class="card">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">
                                        <i class="fas fa-history text-primary"></i> Dernières Visites
                                    </h5>
                                </div>
                                <div class="card-body p-0" style="max-height: 240px; overflow-y: auto;">
                                    {% if recentVisites|length > 0 %}
                                        <ul class="list-group list-group-flush">
                                            {% for visite in recentVisites %}
                                                <li class="list-group-item">
                                                    <div class="d-flex justify-content-between align-items-start">
                                                        <div class="flex-grow-1">
                                                            <h6 class="mb-1">
                                                                {{ visite.getPointVente().getNomPdv() }}
                                                            </h6>
                                                            <small class="text-muted">
                                                                {{ visite.getDateTransac()|date('d/m/Y H:i') }}
                                                            </small>
                                                        </div>
                                                        <span class="badge
                                                            {% if visite.getStatut().value == 'VALIDEE' %}
                                                                bg-success
                                                            {% elseif visite.getStatut().value == 'REJETEE' %}
                                                                bg-danger
                                                            {% else %}
                                                                bg-warning
                                                            {% endif %}">
                                                            {{ visite.getStatut().value }}
                                                        </span>
                                                    </div>
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    {% else %}
                                        <div class="p-4 text-center text-muted">
                                            <i class="fas fa-inbox fa-3x mb-2 opacity-50"></i>
                                            <p>Aucune visite enregistrée</p>
                                        </div>
                                    {% endif %}
                                </div>
                                <div class="card-footer bg-light">
                                    <a href="{{ path('app_agent_visite_list') }}" class="btn btn-sm btn-primary w-100">
                                        <i class="fas fa-list"></i> Voir toutes les visites
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Recent Approvisionnements -->
                        <div class="col-md-12 mb-3">
                            <div class="card">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">
                                        <i class="fas fa-truck text-info"></i> Derniers Approvisionnements
                                    </h5>
                                </div>
                                <div class="card-body p-0" style="max-height: 240px; overflow-y: auto;">
                                    {% if recentApprovisionnements|length > 0 %}
                                        <ul class="list-group list-group-flush">
                                            {% for appro in recentApprovisionnements %}
                                                <li class="list-group-item">
                                                    <div class="d-flex justify-content-between align-items-start">
                                                        <div class="flex-grow-1">
                                                            <h6 class="mb-1">
                                                                {{ appro.getPointVente().getNomPdv() }}
                                                            </h6>
                                                            <small class="text-muted">
                                                                {{ appro.getDateTransac()|date('d/m/Y H:i') }} • {{ appro.getMontant().toDecimal() }} FCFA
                                                            </small>
                                                        </div>
                                                        <span class="badge
                                                            {% if appro.getStatut().value == 'TERMINEE' %}
                                                                bg-success
                                                            {% elseif appro.getStatut().value == 'RECU_PAR_AGENT' %}
                                                                bg-info
                                                            {% else %}
                                                                bg-warning text-dark
                                                            {% endif %}">
                                                            {{ appro.getStatut().value }}
                                                        </span>
                                                    </div>
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    {% else %}
                                        <div class="p-4 text-center text-muted">
                                            <i class="fas fa-truck fa-3x mb-2 opacity-50"></i>
                                            <p>Aucun approvisionnement enregistré</p>
                                        </div>
                                    {% endif %}
                                </div>
                                <div class="card-footer bg-light">
                                    <a href="{{ path('app_agent_approvisionnement_list') }}" class="btn btn-sm btn-info w-100">
                                        <i class="fas fa-list"></i> Voir tous les approvisionnements
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Alertes Seuil -->
            <div class="row mb-4">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header {% if pdvsBelowThreshold|length > 0 %}bg-danger text-white{% else %}bg-light{% endif %}">
                            <h5 class="mb-0"><i class="fas fa-exclamation-triangle"></i> Alertes Seuil Minimal</h5>
                        </div>
                        <div class="card-body">
                            {% if pdvsBelowThreshold|length > 0 %}
                                <div class="list-group">
                                    {% for pdv in pdvsBelowThreshold %}
                                        <div class="list-group-item list-group-item-action">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <h6 class="mb-1">{{ pdv.nom }}</h6>
                                                    <small class="text-muted">{{ pdv.ville }}</small>
                                                </div>
                                                <div class="text-end">
                                                    {% if pdv.cashBelow %}
                                                        <span class="badge bg-danger me-1">Cash: {{ pdv.soldeCash }} FCFA</span>
                                                    {% endif %}
                                                    {% if pdv.flotteBelow %}
                                                        <span class="badge bg-danger">Flotte: {{ pdv.soldeFlotte }} FCFA</span>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <p class="text-muted mb-0">Tous les points de vente sont au-dessus du seuil minimal 👍</p>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header bg-light">
                            <h5 class="mb-0"><i class="fas fa-bolt text-warning"></i> Actions Rapides</h5>
                        </div>
                        <div class="card-body">
                            <a href="{{ path('app_agent_visite_list') }}" class="btn btn-primary me-2">
                                <i class="fas fa-list"></i> Mes Visites
                            </a>
                            <a href="{{ path('app_agent_approvisionnement_list') }}" class="btn btn-info me-2">
                                <i class="fas fa-truck"></i> Mes Approvisionnements
                            </a>
                            <a href="{{ path('app_agent_approvisionnement_list', {statut: 'EN_ATTENTE'}) }}" class="btn btn-warning me-2">
                                <i class="fas fa-hourglass-half"></i> Appro. en Attente
                            </a>
                            <a href="{{ path('app_profil_show') }}" class="btn btn-secondary">
                                <i class="fas fa-user-edit"></i> Éditer Profil
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
