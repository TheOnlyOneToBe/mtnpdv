{% extends 'base.html.twig' %}

{% block title %}Notifications - {{ app_name }}{% endblock %}

{% block body %}
    <div class="container-lg py-4">
        <!-- Header -->
        <div class="row mb-4">
            <div class="col-md-8">
                <h1 class="mb-2"><i class="fas fa-bell"></i> Notifications</h1>
                <p class="text-muted">Toutes vos notifications</p>
            </div>
        </div>

        <!-- Notifications -->
        {% if notifications|length > 0 %}
            <div class="row">
                <div class="col-md-8">
                    {% for notification in notifications %}
                        <div class="card mb-3 notification-card" id="notification-{{ notification.id }}">
                            <div class="card-body">
                                <div class="row align-items-start">
                                    <div class="col-auto">
                                        <div class="badge bg-{{ notification.type.getCouleur() }} rounded-circle p-3" style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;">
                                            <i class="fas {{ notification.type.getIcone() }}"></i>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <h5 class="card-title mb-1">{{ notification.titre }}</h5>
                                                <p class="card-text text-muted mb-2">{{ notification.message }}</p>
                                                <small class="text-muted">
                                                    <i class="fas fa-clock"></i> {{ notification.dateCreation|date('d/m/Y H:i') }}
                                                </small>
                                            </div>
                                            {% if notification.lien %}
                                                <a href="{{ notification.lien }}" class="btn btn-sm btn-primary">
                                                    <i class="fas fa-arrow-right"></i> Voir
                                                </a>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}

                    <!-- Pagination -->
                    {% if hasMore %}
                        <div class="text-center">
                            <a href="{{ path('app_notification_list', {page: currentPage + 1}) }}" class="btn btn-outline-primary">
                                <i class="fas fa-chevron-down"></i> Charger plus
                            </a>
                        </div>
                    {% endif %}
                </div>

                <!-- Sidebar -->
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-header bg-light">
                            <h5 class="mb-0"><i class="fas fa-info-circle"></i> Infos</h5>
                        </div>
                        <div class="card-body">
                            <p class="mb-0">
                                <strong>{{ notifications|length }}</strong> notification(s) affichée(s)
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="alert alert-info" role="alert">
                <i class="fas fa-info-circle"></i>
                <strong>Aucune notification</strong><br>
                Vous n'avez pas de notifications pour le moment.
            </div>
        {% endif %}
    </div>
{% endblock %}
