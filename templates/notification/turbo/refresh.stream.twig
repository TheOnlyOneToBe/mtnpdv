{# Turbo Stream : rafraîchissement du badge et du dropdown notifications #}
<turbo-stream action="update" target="notifications-badge">
    <template>
        {% if count > 0 %}
            <span id="notifications-badge"
                  class="badge bg-danger ms-1"
                  data-notifications-target="badge">{{ count }}</span>
        {% else %}
            <span id="notifications-badge"
                  class="badge bg-danger ms-1 d-none"
                  data-notifications-target="badge"
                  style="display: none;">0</span>
        {% endif %}
    </template>
</turbo-stream>

<turbo-stream action="update" target="notifications-dropdown-list">
    <template>
        <ul class="dropdown-menu dropdown-menu-end notifications-dropdown show"
            id="notifications-dropdown-list"
            data-notifications-target="dropdown"
            aria-labelledby="notificationsDropdown"
            style="min-width: 320px; max-height: 400px; overflow-y: auto; display: block; position: static; border: none; box-shadow: none;">
            {% if notifications is empty %}
                <li class="dropdown-item text-muted">
                    <i class="fas fa-bell-slash"></i> Aucune notification
                </li>
            {% else %}
                {% for notification in notifications %}
                    <li>
                        <a href="{{ notification.lien ?? '#' }}"
                           class="dropdown-item notification-item{% if not notification.lu %} notification-unread{% endif %}"
                           data-notification-id="{{ notification.id }}">
                            <div class="d-flex gap-2 align-items-start">
                                <i class="fas {{ notification.type.icone }} text-{{ notification.type.couleur }} mt-1"></i>
                                <div class="flex-grow-1">
                                    <strong class="d-block">{{ notification.titre }}</strong>
                                    <div class="small text-muted">{{ notification.message|length > 80 ? notification.message|slice(0, 80) ~ '…' : notification.message }}</div>
                                    <div class="small text-muted">{{ notification.dateCreation|date('d/m/Y H:i') }}</div>
                                </div>
                            </div>
                        </a>
                    </li>
                {% endfor %}
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a href="{{ path('app_notification_list') }}" class="dropdown-item text-center small">
                        <i class="fas fa-eye"></i> Voir toutes les notifications
                    </a>
                </li>
            {% endif %}
        </ul>
    </template>
</turbo-stream>

{% if pendingApprovisionnements is defined %}
<turbo-stream action="update" target="sidebar-approvisionnements-badge">
    <template>
        {% if pendingApprovisionnements > 0 %}
            <span id="sidebar-approvisionnements-badge" class="nav-badge">{{ pendingApprovisionnements }}</span>
        {% else %}
            <span id="sidebar-approvisionnements-badge" class="nav-badge" style="display: none;"></span>
        {% endif %}
    </template>
</turbo-stream>
{% endif %}
