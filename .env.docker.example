# Copier ce fichier en ".env.docker" puis ajuster les valeurs.
# Usage : docker compose --env-file .env.docker up -d --build
#
# Ce fichier est dédié à Docker Compose (ports, secrets, credentials MySQL).
# Il est distinct du ".env" de Symfony, qui reste inchangé pour le développement local sans Docker.

# Secret applicatif Symfony (obligatoire) — générer avec: openssl rand -hex 16
APP_SECRET=change-me-with-a-real-random-secret

# Environnement Symfony dans les conteneurs (prod|dev)
APP_ENV=prod

# Port HTTP exposé sur la machine hôte (http://localhost:${HTTP_PORT})
HTTP_PORT=8080

# Base de données MySQL
MYSQL_DATABASE=mtnpdv
MYSQL_USER=mtnpdv
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# Si "true": à CHAQUE démarrage des conteneurs, réinitialise complètement le schéma
# et régénère des données factices (via app:init:database --with-data --force).
# ATTENTION: destructif, à réserver au développement (déjà activé en dev via compose.override.yaml).
FORCE_DB_INIT=false
