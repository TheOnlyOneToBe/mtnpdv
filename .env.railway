# .env.railway
# Variables d'environnement pour Railway

# App
APP_ENV=prod
APP_DEBUG=0

# Session (si vous utilisez des sessions)
SESSION_DRIVER=file

# Base de données - Railway injecte MYSQL_URL automatiquement
DATABASE_URL="${MYSQL_URL}"

# Cache - Utilise Redis si disponible
CACHE_DSN="${REDIS_URL}"

# Lock
LOCK_DSN=flock